# Secrets for the `agents` service in docker-compose.yml.
# Copy to .env (same directory as docker-compose.yml) and fill in.

# LLM access via haex-claude-proxy (Anthropic-compatible) — the agents
# service talks to the claude-proxy service over the internal docker
# network, not the host port.
ANTHROPIC_BASE_URL=http://claude-proxy:8080
ANTHROPIC_API_KEY=proxy-not-used-but-sdk-requires-it
# Must be a model claude-proxy actually serves (GET :12102/v1/models) — it
# rejects unknown names with HTTP 404 rather than falling back. Every agent
# without its own override in the dashboard runs on this one.
ANTHROPIC_MODEL=claude-opus-5

# Bearer token for claude-proxy's web-driven OAuth setup flow
# (http://<host>:12102/setup/?token=...). Generate with: openssl rand -hex 32
PROXY_SETUP_TOKEN=

# Shared secret for the MCP tool bridge: claude-proxy POSTs the model's tool
# calls back to the agents service with this token. Empty = bridge off, and the
# Researcher runs without its prior-art gate and without web search.
# Generate with: openssl rand -hex 32
INTERNAL_TOOL_EXEC_KEY=

# fwbg API authentication.
# The `api` service is not published to the host (no ports mapping), so it
# runs with FWBG_ALLOW_UNAUTHENTICATED_API=1 on the internal compose network.
# Set a shared key here to require X-API-Key on every /api request; it is then
# wired to both `api` and `agents`. NOTE: the dashboard image does not yet send
# X-API-Key, so enabling this breaks dashboard->api until that lands.
# Generate with: openssl rand -hex 32
FWBG_API_KEY=

# Backtest concurrency. Default 1 (safe for memory-heavy optimizer runs and
# agent orchestration, which expects 429 + waits when the slot is busy). Raise
# only with enough RAM/CPU. NOTE: docker-compose pins this to 1 on the `api`
# service directly; this entry applies when running the API outside compose.
FWBG_MAX_CONCURRENT_RUNS=1

# Web research
TAVILY_API_KEY=
BRAVE_API_KEY=

# IG broker (only needed once M6/M7 land)
IG_DEMO_USERNAME=
IG_DEMO_PASSWORD=
IG_DEMO_API_KEY=
IG_LIVE_USERNAME=
IG_LIVE_PASSWORD=
IG_LIVE_API_KEY=

# GitHub PAT for PromoteAgent (only needed once M8 lands)
GITHUB_TOKEN=
