{
  "name": "Weekly ORB Scalping",
  "description": "Rule-based Weekly ORB strategy. First 30-60 min of Monday define the weekly range. Breakout + retracement entries with trailing stop.",
  "tags": [
    "weekly_orb",
    "orb",
    "intraday",
    "swing",
    "rule_based"
  ],
  "timeframe": "MINUTE_15",
  "hypothesis": "Weekly Opening Ranges are observed by institutional participants. Breakouts over WOR High/Low have higher continuation probability. Rule-based entries with grid-optimized TP/SL.",
  "expected_outcome": "WOR retest signals dominate entries. Stronger edge than daily ORB on weekly basis.",
  "pipeline": "weekly_orb_v1",
  "model": "signal_orb_v1",
  "validation": "walk_forward_intraday_v1",
  "filters": "weekly_orb_v1",
  "resources": "standard_v1",
  "datasource": "forexsb",
