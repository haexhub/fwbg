{
  "name": "sr_trend_continuation",
  "description": "S/R Trend Continuation: Long an Support im Uptrend, Short an Resistance im Downtrend. Isolierter S/R-Edge-Test auf NAS100 und DAX.",
  "tags": ["support_resistance", "trend_continuation", "price_action", "index"],
  "hypothesis": "S/R-Zonen mit Trend-Kontext liefern Edge fuer profitable Entries ohne klassische technische Indikatoren.",
  "expected_outcome": "sr_trend_class-Filter verbessert WR gegenueber unkonditioniertem S/R-Breakout.",
  "datasource": "dukascopy",
  "timeframe": "MINUTE_15",
  "assets": {
    "filter": ["NAS100", "DAX"]
  },
  "pipeline": "sr_trend_v1",
  "model": "xgboost_depth3_v1",
  "validation": "walk_forward_sr_trend_v1",
  "filters": "sr_strict_v1",
  "resources": "standard_v1",
  "risk_management": "vol_targeted_kelly",
  "risk_params": {
    "kelly_fraction": 0.25,
    "max_risk": 0.05,
    "target_max_dd": 0.3,
    "circuit_breaker_loss_range": [3, 8],
    "circuit_breaker_pause_range": [5, 30],
    "target_vol": 15,
    "min_scale": 0.25,
    "max_scale": 2
  },
  "optimization": {
    "regime_filter_grid": {
      "condition_grids": [
        {
          "column": "sr_trend_class",
          "operator": ">=",
          "values": [null, 1],
          "directions": 4,
          "else_directions": 0
        },
        {
          "column": "sr_trend_class",
          "operator": "<=",
          "values": [null, -1],
          "directions": 2,
          "else_directions": 0
        }
      ]
    }
  },
  "signal_rules": {
    "long": {
      "operator": "AND",
      "conditions": [
        {
          "type": "value_check",
          "column": "sr_at_support_in_uptrend",
          "op": ">",
          "value": 0
        }
      ]
    },
    "short": {
      "operator": "AND",
      "conditions": [
        {
          "type": "value_check",
          "column": "sr_at_resistance_in_downtrend",
          "op": ">",
          "value": 0
        }
      ]
    }
  },
  "exit_strategies": [
    {
      "name": "atr_based",
      "params": {
        "atr_period": 14,
        "min_tp_pips": 8,
        "min_sl_pips": 12,
        "tp_mult": 2.0,
        "sl_mult": 1.0,
        "timeout_bars": null
      },
      "ct": [0.35, 0.4, 0.45]
    },
    {
      "name": "atr_based",
      "params": {
        "atr_period": 14,
        "min_tp_pips": 8,
        "min_sl_pips": 12,
        "tp_mult": 2.0,
        "sl_mult": 1.5,
        "timeout_bars": null
      },
      "ct": [0.35, 0.4, 0.45]
    },
    {
      "name": "atr_based",
      "params": {
        "atr_period": 14,
        "min_tp_pips": 8,
        "min_sl_pips": 12,
        "tp_mult": 2.5,
        "sl_mult": 1.0,
        "timeout_bars": null
      },
      "ct": [0.35, 0.4, 0.45]
    },
    {
      "name": "atr_based",
      "params": {
        "atr_period": 14,
        "min_tp_pips": 8,
        "min_sl_pips": 12,
        "tp_mult": 2.5,
        "sl_mult": 1.5,
        "timeout_bars": null
      },
      "ct": [0.35, 0.4, 0.45]
    }
  ]
}
