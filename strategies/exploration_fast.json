{
  "name": "Exploration Fast",
  "description": "Volle Exploration ohne Preprocessing - ermoeglicht Target-Caching fuer schnellere Grid-Suche",
  "tags": ["exploration", "fast", "no_preprocessing", "cached_targets"],
  "hypothesis": "ML soll selbst lernen, welche Features relevant sind - ohne Preprocessing fuer Target-Caching",
  "expected_outcome": "Identifikation der wichtigsten Features mit beschleunigter Grid-Suche durch Caching",

  "pipeline": {
    "preprocessing": [
      {"name": "fractional_diff", "params": {"auto_d": false, "default_d": 0.4, "columns": ["O", "H", "L", "C"]}}
    ],
    "indicators": [
      {"name": "trend", "params": {"adx_periods": [7, 14, 21], "ema_periods": [8, 21, 50, 100, 200], "supertrend_period": 14, "supertrend_multiplier": 3.0}},
      {"name": "momentum", "params": {"rsi_periods": [7, 14, 21]}},
      {"name": "volatility", "params": {"atr_periods": [7, 14, 21], "vol_est_windows": [20, 50]}},
      {"name": "regime", "params": {"hurst_windows": [100, 200, 500], "entropy_windows": [50, 100], "vr_windows": [100, 200], "vr_lags": [5, 10]}},
      {"name": "structure", "params": {}},
      {"name": "risk", "params": {"dd_windows": [50, 100, 200]}},
      {"name": "price_action", "params": {}},
      {"name": "time_season", "params": {}},
      {"name": "distribution", "params": {"windows": [20, 50, 100]}},
      {"name": "dynamics", "params": {}},
      {"name": "multi_timeframe", "params": {}},
      {"name": "cross_features", "params": {}},
      {"name": "ichimoku", "params": {}},
      {"name": "microstructure", "params": {}},
      {"name": "macro_surprise", "params": {}},
      {"name": "market_regime", "params": {"window": 50}},
      {"name": "regime_cluster", "params": {"zscore_window": 200, "quantile_window": 500, "n_regimes": 3}}
    ],
    "feature_selection": [
      {"name": "boruta", "params": {"max_features": 50, "n_estimators": 50, "max_depth": 4, "min_z_score": 0.5}}
    ],
    "data_loading": [
      {"name": "macro_data", "source": "forexsb"},
      {"name": "cot_positioning", "source": "forexsb"}
    ]
  },

  "exit_strategy": "fixed",

  "exit_params": {},

  "model": {
    "type": "xgboost",
    "architecture": "long_short_separate",
    "trade_directions": ["long", "short"],
    "hyperparameters": {
      "n_estimators": 100,
      "max_depth": 6,
      "learning_rate": 0.1,
      "subsample": 0.8,
      "colsample_bytree": 0.8,
      "random_state": 42
    }
  },

  "grids": {
    "FOREX": {
      "tp": [10, 20, 30],
      "sl": [20, 30, 50],
      "ct": [0.6, 0.65],
      "regime_filter_grid": {
        "condition_grids": [
          {"column": "trend_adx_14", "operator": ">=", "values": [null, 25], "directions": 6, "else_directions": 0},
          {"column": "macro_vix", "operator": "<=", "values": [null, 30], "directions": 6, "else_directions": 0},
          {"column": "regime_hurst_100", "operator": ">=", "values": [null, 0.45], "directions": 6, "else_directions": 0},
          {"column": "regime_cluster_label", "operator": ">=", "values": [null, 1, 2], "directions": 6, "else_directions": 0}
        ]
      }
    },
    "INDEX": {
      "tp": [10, 20, 30, 50],
      "sl": [30, 50, 70],
      "ct": [0.6, 0.65],
      "regime_filter_grid": {
        "condition_grids": [
          {"column": "trend_adx_14", "operator": ">=", "values": [null, 25], "directions": 6, "else_directions": 0},
          {"column": "macro_vix", "operator": "<=", "values": [null, 30], "directions": 6, "else_directions": 0},
          {"column": "regime_hurst_100", "operator": ">=", "values": [null, 0.45], "directions": 6, "else_directions": 0},
          {"column": "regime_cluster_label", "operator": ">=", "values": [null, 1, 2], "directions": 6, "else_directions": 0}
        ]
      }
    },
    "COMMODITY": {
      "tp": [10, 20, 30],
      "sl": [30, 50, 70],
      "ct": [0.6, 0.65],
      "regime_filter_grid": {
        "condition_grids": [
          {"column": "trend_adx_14", "operator": ">=", "values": [null, 25], "directions": 6, "else_directions": 0},
          {"column": "macro_vix", "operator": "<=", "values": [null, 30], "directions": 6, "else_directions": 0},
          {"column": "regime_hurst_100", "operator": ">=", "values": [null, 0.45], "directions": 6, "else_directions": 0},
          {"column": "regime_cluster_label", "operator": ">=", "values": [null, 1, 2], "directions": 6, "else_directions": 0}
        ]
      }
    },
    "CRYPTO": {
      "tp": [20, 50, 80],
      "sl": [50, 80, 120],
      "ct": [0.6, 0.65],
      "regime_filter_grid": {
        "condition_grids": [
          {"column": "trend_adx_14", "operator": ">=", "values": [null, 25], "directions": 6, "else_directions": 0},
          {"column": "macro_vix", "operator": "<=", "values": [null, 30], "directions": 6, "else_directions": 0},
          {"column": "regime_hurst_100", "operator": ">=", "values": [null, 0.45], "directions": 6, "else_directions": 0},
          {"column": "regime_cluster_label", "operator": ">=", "values": [null, 1, 2], "directions": 6, "else_directions": 0}
        ]
      }
    }
  },

  "validation": {
    "method": "walk_forward",
    "folds": 8,
    "oos_size": 4000,
    "min_trades": 50,
    "n_inner_folds": 5,
    "embargo_bars": 100,
    "sample_weights": true
  },

  "filters": {
    "min_rrr": 0,
    "min_trades": 30,
    "min_annual_return": 0,
    "min_sharpe": 0,
    "max_drawdown": 1.0
  },

  "resources": {
    "ram_per_worker_gb": 2.0,
    "min_free_ram_percent": 0.10,
    "max_cpu_percent": 0.9,
    "max_concurrent_assets": 2,
    "xgboost_n_jobs": 0
  }
}
