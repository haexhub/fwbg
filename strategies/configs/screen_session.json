{
  "name": "Screen: Session & Time Effects",
  "description": "Konzept-Screening: Reine Zeit- und Sessionseffekte (Tageszeit, Wochentag, Kalender) auf M15-Daten. Kein technisches Signal - nur Zeit als Prädiktor.",
  "tags": [
    "screening",
    "step1",
    "session",
    "time",
    "intraday"
  ],
  "timeframe": "MINUTE_15",
  "hypothesis": "Systematische Zeit-Asymmetrien (bestimmte Stunden/Wochentage bevorzugen Long oder Short) existieren unabhängig von technischen Signalen. Kalendereffekte und Session-Transitions haben prädiktiven Wert.",
  "expected_outcome": "Stunden-Encoding und Wochentag werden selektiert. Unterschiedliche Win-Rates für Long/Short je nach Tageszeit.",
  "pipeline": {
    "indicators": [
      {
        "name": "time_season",
        "params": {
          "include_raw": true,
          "include_encoded": true
        }
      },
      {
        "name": "calendar_events",
        "params": {}
      },
      {
        "name": "price_action",
        "params": {
          "hh_ll_period": 5,
          "compute_volume": true
        }
      }
    ],
    "feature_selection": [
      {
        "name": "stability",
        "params": {
          "inner_selector": "boruta",
          "inner_params": {
            "n_iter": 5,
            "n_estimators": 30,
            "max_depth": 4,
            "min_z_score": 0.5
          },
          "n_bootstrap": 3,
          "threshold": 0.6,
          "bootstrap_ratio": 0.8
        }
      },
      {
        "name": "correlation_filter",
        "params": {
          "max_correlation": 0.7,
          "max_features": 15
        }
      }
    ]
  },
  "model": "xgboost_screen_v1",
  "validation": "walk_forward_screening_intraday_v1",
  "filters": "screening_v1",
  "resources": "exploration_heavy_v1",
  "datasource": "forexsb",
  "exit_strategies": [
    {
      "name": "atr_based",
      "params": {
        "atr_period": 14,
        "min_tp_pips": 10,
        "min_sl_pips": 15,
        "adaptive_timeout": false,
        "tp_mult": 1.5,
        "sl_mult": 2.0,
        "timeout_bars": null
      },
      "ct": [
        0.5,
