          "directions": 6,
          "else_directions": 0
        },
        {
          "column": "macro_vix",
          "operator": "<=",
          "values": [
            null,
            30
          ],
          "directions": 6,
          "else_directions": 0
        },
        {
          "column": "regime_hurst_100",
          "operator": ">=",
          "values": [
            null,
            0.45
          ],
          "directions": 6,
          "else_directions": 0
        },
        {
          "column": "regime_cluster_label",
          "operator": ">=",
          "values": [
            null,
            1,
            2
          ],
          "directions": 6,
          "else_directions": 0
        }
      ]
    }
  }
