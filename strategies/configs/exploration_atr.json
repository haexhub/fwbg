{
  "name": "Exploration ATR",
  "description": "Maximale Feature-Exploration mit ATR-basierter dynamischer Exit-Strategie - TP/SL passen sich der Volatilität an",
  "tags": [
    "exploration",
    "parameter_search",
    "full_features",
    "ml_driven",
    "atr_based",
    "dynamic_exits"
  ],
  "hypothesis": "ATR-basierte dynamische TP/SL bieten bessere Anpassung an Marktvolatilität als fixe Spread-Multiplikatoren. ML lernt optimale ATR-Multiplikatoren für verschiedene Marktregime.",
  "expected_outcome": "Höhere Risk-Adjusted Returns durch volatilitäts-angepasste Exits. Bessere Performance in verschiedenen Volatilitätsregimen.",
  "pipeline": "exploration_full_atr_v1",
  "exit_strategy": "atr_based",
  "exit_params": {
    "atr_period": [
      14
    ],
    "min_tp_pips": [
      10
    ],
    "min_sl_pips": [
      15
    ],
    "adaptive_timeout": [
      false
    ],
    "tp_mult": [
      1.5,
      2.0,
      2.5,
      3.0,
      3.5,
      4.0,
      4.5,
      5.0,
      6.0
    ],
    "sl_mult": [
      3,
      4,
      5,
      6,
      7
    ],
    "timeout_bars": [
      null,
      24,
      48
    ]
  },
  "model": "xgboost_depth6_v1",
  "validation": "walk_forward_exploration_atr_v1",
  "filters": "permissive_v1",
  "resources": "standard_v1",
  "datasource": "forexsb",
  "optimization": {
    "ct": [
      0.5,
      0.55,
      0.6,
      0.65
    ],
    "regime_filter_grid": {
      "condition_grids": [
        {
          "column": "trend_adx_14",
