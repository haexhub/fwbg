{
  "name": "orb-dax-ml",
  "description": "DAX ML: 8 variants (sessions 7/8 × rb 4/12 × prb 0/6), depth=2, loose FS",
  "tags": ["orb", "ml", "index", "dax"],
  "datasource": "dukascopy",
  "timeframe": "MINUTE_15",
  "assets": {
    "filter": ["DAX"]
  },
  "pipeline": {
    "data_loading": [],
    "preprocessing": [],
    "indicators": [
      {
        "name": "opening_range",
        "params": {
          "range_bars": [12],
          "atr_period": 14,
          "sessions": [8],
          "enable_retracement": false,
          "carry_forward_days": [0],
          "pre_range_bars": [6],
          "candle_span": "body",
          "breakout_threshold": 0,
          "breakout_threshold_abs": 5,
          "retracement_levels": [],
          "min_retracement": 0,
          "min_range_height": 40,
          "min_range_height_atr": 0
        }
      },
      {
        "name": "trend",
        "params": {
          "adx_periods": [14, 21],
          "ema_periods": [8, 21, 50, 200],
          "supertrend_period": 14,
          "supertrend_multiplier": 3.0
        }
      },
      {
        "name": "momentum",
        "params": {
          "rsi_periods": [7, 14, 21],
          "stoch_periods": [14],
          "roc_periods": [5, 10, 20]
        }
      },
      {
        "name": "volatility",
        "params": {
          "atr_periods": [7, 14, 21],
          "vol_est_windows": [20, 50]
        }
      },
      {
        "name": "time_season",
        "params": {
          "include_raw": true,
          "include_encoded": true
        }
      },
      {
        "name": "price_action",
        "params": {
          "hh_ll_period": 5,
          "compute_volume": false
        }
      },
      {
        "name": "displacement",
        "params": {}
      },
      {
        "name": "vwap",
        "params": {
          "session_start_hour": 7,
          "zscore_windows": [20, 50]
        }
      },
      {
        "name": "previous_day_levels",
        "params": {
          "candle_span": "hl",
          "range_scope": ["session"],
          "break_modes": ["all_hours"],
          "retest_modes": ["all_hours"],
          "retracement_levels": 0.5,
          "enable_retest": true
        }
      },
      {
        "name": "market_structure",
        "params": {
          "swing_lookback": 20,
          "choch_lookback": 50
        }
      }
    ],
    "feature_selection": [
      {
        "name": "stability",
        "params": {
          "inner_selector": "boruta",
          "inner_params": {
            "n_iter": 5,
            "n_estimators": 30,
            "min_z_score": 0.1
          },
          "n_bootstrap": 8,
          "threshold": 0.3
        }
      },
      {
        "name": "correlation_filter",
        "params": {
          "max_correlation": 0.7
        }
      }
    ]
  },
  "model": {
    "type": "xgboost",
    "architecture": "long_short_separate",
    "trade_directions": ["long", "short"],
    "hyperparameters": {
      "n_estimators": 50,
      "max_depth": 2,
      "learning_rate": 0.1,
      "subsample": 0.8,
      "colsample_bytree": 0.8,
      "random_state": 42
    }
  },
  "validation": {
    "method": "walk_forward",
    "folds": 8,
    "early_termination": false,
    "first_fold_sanity_check": false,
    "min_fold_stability": 0.25
  },
  "filters": {
    "min_trades": 20
  },
  "resources": {},
  "risk_management": "vol_targeted_kelly",
  "risk_params": {
    "kelly_fraction": 0.25,
    "max_risk": 0.05,
    "target_max_dd": 0.3,
    "circuit_breaker_loss_range": [3, 8],
    "circuit_breaker_pause_range": [5, 30],
    "target_vol": 15,
    "min_scale": 0.25,
    "max_scale": 2
  },
  "exit_strategies": [
    {
      "name": "orb_based",
      "params": {
        "tp_mode": "range",
        "tp_mult": 1,
        "sl_mult": 1.3,
        "atr_period": 14,
        "min_tp_pips": 8,
        "min_sl_pips": 5,
        "timeout_bars": null,
        "sl_level": "none",
        "entry_delay": 0,
        "max_trades_per_signal": 1
      },
      "ct": [0.3, 0.35, 0.4, 0.45, 0.5],
      "min_rrr": 0,
      "entry_modifier": "scale_in",
      "entry_modifier_params": {
        "levels": [0.5],
        "qty_multiplier": 1
      }
    },
    {
      "name": "orb_based",
      "params": {
        "tp_mode": "range",
        "tp_mult": 1,
        "sl_mult": 1.3,
        "atr_period": 14,
        "min_tp_pips": 8,
        "min_sl_pips": 5,
        "timeout_bars": null,
        "sl_level": "none",
        "entry_delay": 0,
        "max_trades_per_signal": 1
      },
      "ct": [0.3, 0.35, 0.4, 0.45, 0.5],
      "min_rrr": 0
    }
  ],
  "optimization": {
    "indicator_grid": {
      "opening_range": {
        "sessions": [[7], [8]],
        "range_bars": [[4], [12]],
        "pre_range_bars": [[0], [6]]
      }
    }
  },
  "signal_rules": {
    "long": {
      "operator": "AND",
      "conditions": [
        {
          "type": "signal_active",
          "column": "breakout_up"
        },
        {
          "type": "value_check",
          "column": "breakout_dist",
          "op": "<=",
          "value": 0.2
        }
      ]
    },
    "short": {
      "operator": "AND",
      "conditions": [
        {
          "type": "signal_active",
          "column": "breakout_down"
        },
        {
          "type": "value_check",
          "column": "breakout_dist",
          "op": "<=",
          "value": 0.2
        }
      ]
    }
  }
}
