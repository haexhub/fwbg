{
  "name": "trend-pullback-momentum",
  "description": "Trend + Pullback + Momentum Break: EMA trend filter, BOS confirmation, 38% Fibonacci retracement, entry on local LH/HL break. Structural SL below pullback low + ATR buffer, TP at 2R.",
  "tags": ["trend", "pullback", "momentum", "forex"],
  "datasource": "dukascopy",
  "timeframe": "HOUR_1",

  "assets": {
    "filter": ["EURUSD"]
  },

  "pipeline": {
    "data_loading": [],
    "preprocessing": [],

    "indicators": [
      {
        "name": "pullback_momentum",
        "params": {
          "ema_period": 200,
          "swing_lookback": 20,
          "min_pullback_pct": 0.382,
          "local_high_lookback": 3,
          "sl_buffer_mult": 0.25,
          "atr_period": 14
        }
      },
      {
        "name": "trend",
        "params": {
          "ema_periods": [200],
          "adx_periods": [14],
          "supertrend_period": 14,
          "supertrend_multiplier": 3.0
        }
      },
      {
        "name": "momentum",
        "params": {
          "rsi_periods": [14],
          "stoch_periods": [14],
          "roc_periods": [10]
        }
      },
      {
        "name": "volatility",
        "params": {
          "atr_periods": [14],
          "vol_est_windows": [20]
        }
      },
      {
        "name": "time_season",
        "params": {
          "include_raw": true,
          "include_encoded": true
        }
      }
    ],

    "feature_selection": [
      {
        "name": "stability",
        "params": {
          "inner_selector": "boruta",
          "inner_params": {
            "n_iter": 5,
            "n_estimators": 30,
            "min_z_score": 0.1
          },
          "n_bootstrap": 5,
          "threshold": 0.3
        }
      },
      {
        "name": "correlation_filter",
        "params": {
          "max_correlation": 0.7
        }
      }
    ]
  },

  "model": {
    "type": "xgboost",
    "architecture": "long_short_separate",
    "trade_directions": ["long", "short"],
    "hyperparameters": {
      "n_estimators": 50,
      "max_depth": 3,
      "learning_rate": 0.1,
      "subsample": 0.8,
      "colsample_bytree": 0.8,
      "random_state": 42
    }
  },

  "validation": {
    "method": "walk_forward",
    "folds": 6,
    "early_termination": false,
    "min_fold_stability": 0.25
  },

  "filters": {
    "min_trades": 20
  },

  "resources": {},

  "signal_rules": {
    "long": {
      "operator": "AND",
      "conditions": [
        {
          "type": "signal_active",
          "column": "tpm_entry_long"
        }
      ]
    },
    "short": {
      "operator": "AND",
      "conditions": [
        {
          "type": "signal_active",
          "column": "tpm_entry_short"
        }
      ]
    }
  },

  "exit_strategies": [
    {
      "name": "structural_rr",
      "params": {
        "tp": 2.0,
        "sl_dist_column_long": "tpm_sl_dist_long",
        "sl_dist_column_short": "tpm_sl_dist_short",
        "min_tp_pips": 10,
        "min_sl_pips": 5
      },
      "ct": [0.35, 0.4, 0.45, 0.5, 0.55],
      "min_rrr": 0
    }
  ],

  "optimization": {
    "indicator_grid": {
      "pullback_momentum": {
        "ema_period": [100, 200],
        "swing_lookback": [15, 20],
        "min_pullback_pct": [0.382, 0.5],
        "sl_buffer_mult": [0.25, 0.5]
      }
    }
  },

  "regime_filter": "adx_only_v1"
}
