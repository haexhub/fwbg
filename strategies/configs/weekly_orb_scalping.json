{
  "name": "Weekly ORB Scalping",
  "description": "Rule-based Weekly ORB strategy. First 30-60 min of Monday define the weekly range. Breakout + retracement entries with trailing stop.",
  "tags": [
    "weekly_orb",
    "orb",
    "intraday",
    "swing",
    "rule_based"
  ],
  "timeframe": "MINUTE_15",
  "hypothesis": "Weekly Opening Ranges are observed by institutional participants. Breakouts over WOR High/Low have higher continuation probability. Rule-based entries with grid-optimized TP/SL.",
  "expected_outcome": "WOR retest signals dominate entries. Stronger edge than daily ORB on weekly basis.",
  "pipeline": "weekly_orb_v1",
  "exit_strategy": "orb_based",
  "exit_params": "orb_wor_v1",
  "exit_modifier": "trailing_stop",
  "exit_modifier_params": {
    "breakeven_trigger": 0.5,
    "trail_atr_mult": 0.5
  },
  "model": "signal_orb_v1",
  "validation": "walk_forward_intraday_v1",
  "filters": "weekly_orb_v1",
  "resources": "standard_v1",
  "grids": {
    "presets_dir": "../grids",
    "assignments": {
      "FOREX": {
        "preset": "weekly_orb_forex_v1",
        "ct": [0.5],
        "tp": [2.0, 2.5, 3.0, 4.0, 5.0],
        "model_hyperparameters": {
          "signal_column_long": "wor_rb2_retest_zone_up",
          "signal_column_short": "wor_rb2_retest_zone_down"
        },
        "required_features": ["wor_rb2_retest_zone_up", "wor_rb2_retest_zone_down"]
      },
      "INDEX": {
        "preset": "weekly_orb_index_v1",
        "ct": [0.5],
        "tp": [4.0, 5.0, 6.0, 8.0, 10.0],
        "model_hyperparameters": {
          "signal_column_long": "wor_rb2_retest_zone_up",
          "signal_column_short": "wor_rb2_retest_zone_down"
        },
        "required_features": ["wor_rb2_retest_zone_up", "wor_rb2_retest_zone_down"]
      },
      "COMMODITY": {
        "preset": "weekly_orb_base_v1",
        "ct": [0.5],
        "tp": [2.5, 3.0, 4.0, 5.0],
        "model_hyperparameters": {
          "signal_column_long": "wor_rb2_retest_zone_up",
          "signal_column_short": "wor_rb2_retest_zone_down"
        },
        "required_features": ["wor_rb2_retest_zone_up", "wor_rb2_retest_zone_down"]
      },
      "CRYPTO": {
        "preset": "weekly_orb_crypto_v1",
        "ct": [0.5],
        "tp": [3.0, 4.0, 5.0, 6.0, 8.0],
        "model_hyperparameters": {
          "signal_column_long": "wor_rb2_retest_zone_up",
          "signal_column_short": "wor_rb2_retest_zone_down"
        },
        "required_features": ["wor_rb2_retest_zone_up", "wor_rb2_retest_zone_down"]
      }
    }
  }
}
