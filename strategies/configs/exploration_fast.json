{
  "name": "Exploration Fast",
  "description": "Volle Exploration ohne Preprocessing - ermoeglicht Target-Caching fuer schnellere Grid-Suche",
  "tags": [
    "exploration",
    "fast",
    "no_preprocessing",
    "cached_targets"
  ],
  "hypothesis": "ML soll selbst lernen, welche Features relevant sind - ohne Preprocessing fuer Target-Caching",
  "expected_outcome": "Identifikation der wichtigsten Features mit beschleunigter Grid-Suche durch Caching",
  "pipeline": "exploration_fast_v1",
  "exit_strategy": "atr_based",
  "exit_params": {
    "atr_period": [
      14
    ],
    "min_tp_pips": [
      10
    ],
    "min_sl_pips": [
      15
    ],
    "tp_mult": [
      1.5,
      2.0,
      2.5,
      3.0,
      3.5,
      4.0,
      4.5,
      5.0,
      6.0
    ],
    "sl_mult": [
      3,
      4,
      5,
      6,
      7
    ],
    "timeout_bars": [
      null,
      24,
      48
    ]
  },
  "model": "xgboost_depth6_v1",
  "validation": "walk_forward_exploration_fast_v1",
  "filters": "permissive_v1",
  "resources": "exploration_heavy_v1",
  "datasource": "forexsb",
  "optimization": {
    "ct": [
      0.55,
      0.6,
      0.65
    ],
    "regime_filter_grid": {
      "condition_grids": [
        {
          "column": "trend_adx_14",
          "operator": ">=",
          "values": [
            null,
            25
          ],
          "directions": 6,
          "else_directions": 0
        },
        {
          "column": "macro_vix",
          "operator": "<=",
          "values": [
            null,
            30
          ],
          "directions": 6,
          "else_directions": 0
        },
        {
          "column": "regime_hurst_100",
          "operator": ">=",
          "values": [
            null,
            0.45
          ],
          "directions": 6,
          "else_directions": 0
        },
        {
          "column": "regime_cluster_label",
          "operator": ">=",
          "values": [
            null,
            1,
            2
          ],
          "directions": 6,
          "else_directions": 0
        }
      ]
    }
  }
}
