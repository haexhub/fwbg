{
  "name": "Screen: Momentum",
  "description": "Konzept-Screening: Technische Momentum-Indikatoren (RSI, ADX, ROC) auf HOUR-Daten. Testet ob Trend-Stärke und Overbought/Oversold-Signale prädiktiv sind.",
  "tags": ["screening", "step1", "momentum", "technical"],
  "hypothesis": "Momentum-Signale (ADX Trend-Stärke, RSI, ROC) haben prädiktiven Edge für Trend-Fortsetzung auf stündlichen Daten.",
  "expected_outcome": "ADX und RSI werden selektiert. Edge nur in Trending-Phasen.",
  "pipeline": {
    "indicators": [
      {
        "name": "trend",
        "params": {
          "adx_periods": [14, 21],
          "ema_periods": [21, 50, 200],
          "sma_periods": [],
          "cci_periods": [],
          "aroon_period": 14,
          "er_periods": [10, 20],
          "supertrend_period": 14,
          "supertrend_multiplier": 3.0
        }
      },
      {
        "name": "momentum",
        "params": {
          "rsi_periods": [7, 14],
          "stoch_periods": [14],
          "williams_periods": [14],
          "roc_periods": [5, 10, 20]
        }
      },
      {
        "name": "time_season",
        "params": {
          "include_raw": false,
          "include_encoded": true
        }
      }
    ],
    "feature_selection": [
      {
        "name": "stability",
        "params": {
          "inner_selector": "boruta",
          "inner_params": {
            "n_iter": 5,
            "n_estimators": 30,
            "max_depth": 4,
            "min_z_score": 0.5
          },
          "n_bootstrap": 3,
          "threshold": 0.6,
          "bootstrap_ratio": 0.8
        }
      },
      {
        "name": "correlation_filter",
        "params": {
          "max_correlation": 0.7,
          "max_features": 15
        }
      }
    ]
  },
  "exit_strategy": "atr_based",
  "exit_params": "atr_standard_at",
  "model": "xgboost_screen",
  "validation": "walk_forward_screening",
  "filters": "screening",
  "resources": "exploration_heavy",
  "grids": {
    "presets_dir": "../grids",
    "assignments": {
      "FOREX":     {"preset": "screening_base", "tp": [1.5, 2.5, 3.5], "sl": [2.0, 3.0, 4.0]},
      "INDEX":     {"preset": "screening_base", "tp": [2.0, 3.0, 4.0], "sl": [3.0, 4.0, 5.0]},
      "COMMODITY": {"preset": "screening_base", "tp": [2.0, 3.0, 4.0], "sl": [3.0, 4.0, 5.0]},
      "CRYPTO":    {"preset": "screening_base", "tp": [2.0, 3.0, 5.0], "sl": [3.0, 5.0, 7.0]}
    }
  }
}
