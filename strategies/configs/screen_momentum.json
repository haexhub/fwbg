{
  "name": "Screen: Momentum",
  "description": "Konzept-Screening: Technische Momentum-Indikatoren (RSI, ADX, ROC) auf HOUR-Daten. Testet ob Trend-Stärke und Overbought/Oversold-Signale prädiktiv sind.",
  "tags": [
    "screening",
    "step1",
    "momentum",
    "technical"
  ],
  "hypothesis": "Momentum-Signale (ADX Trend-Stärke, RSI, ROC) haben prädiktiven Edge für Trend-Fortsetzung auf stündlichen Daten.",
  "expected_outcome": "ADX und RSI werden selektiert. Edge nur in Trending-Phasen.",
  "pipeline": {
    "indicators": [
      {
        "name": "trend",
        "params": {
          "adx_periods": [
            14,
            21
          ],
          "ema_periods": [
            21,
            50,
            200
          ],
          "sma_periods": [],
          "cci_periods": [],
          "aroon_period": 14,
          "er_periods": [
            10,
            20
          ],
          "supertrend_period": 14,
          "supertrend_multiplier": 3.0
        }
      },
      {
        "name": "momentum",
        "params": {
          "rsi_periods": [
            7,
            14
          ],
          "stoch_periods": [
            14
          ],
          "williams_periods": [
            14
          ],
          "roc_periods": [
            5,
            10,
            20
          ]
        }
      },
      {
        "name": "time_season",
        "params": {
          "include_raw": false,
          "include_encoded": true
        }
      }
    ],
    "feature_selection": [
      {
        "name": "stability",
        "params": {
          "inner_selector": "boruta",
          "inner_params": {
            "n_iter": 5,
            "n_estimators": 30,
            "max_depth": 4,
            "min_z_score": 0.5
          },
          "n_bootstrap": 3,
          "threshold": 0.6,
          "bootstrap_ratio": 0.8
        }
      },
      {
        "name": "correlation_filter",
        "params": {
          "max_correlation": 0.7,
          "max_features": 15
        }
      }
    ]
  },
  "model": "xgboost_screen_v1",
  "validation": "walk_forward_screening_v1",
  "filters": "screening_v1",
  "resources": "exploration_heavy_v1",
  "datasource": "forexsb",
  "exit_strategies": [
    {
      "name": "atr_based",
      "params": {
        "atr_period": 14,
        "min_tp_pips": 10,
        "min_sl_pips": 15,
        "adaptive_timeout": false,
        "tp_mult": 1.5,
        "sl_mult": 2.0,
