{
  "name": "Screen: Momentum",
  "description": "Konzept-Screening: Technische Momentum-Indikatoren (RSI, ADX, ROC) auf HOUR-Daten. Testet ob Trend-St\u00e4rke und Overbought/Oversold-Signale pr\u00e4diktiv sind.",
  "tags": [
    "screening",
    "step1",
    "momentum",
    "technical"
  ],
  "hypothesis": "Momentum-Signale (ADX Trend-St\u00e4rke, RSI, ROC) haben pr\u00e4diktiven Edge f\u00fcr Trend-Fortsetzung auf st\u00fcndlichen Daten.",
  "expected_outcome": "ADX und RSI werden selektiert. Edge nur in Trending-Phasen.",
  "pipeline": {
    "indicators": [
      {
        "name": "trend",
        "params": {
          "adx_periods": [
            14,
            21
          ],
          "ema_periods": [
            21,
            50,
            200
          ],
          "sma_periods": [],
          "cci_periods": [],
          "aroon_period": 14,
          "er_periods": [
            10,
            20
          ],
          "supertrend_period": 14,
          "supertrend_multiplier": 3.0
        }
      },
      {
        "name": "momentum",
        "params": {
          "rsi_periods": [
            7,
            14
          ],
          "stoch_periods": [
            14
          ],
          "williams_periods": [
            14
          ],
          "roc_periods": [
            5,
            10,
            20
          ]
        }
      },
      {
        "name": "time_season",
        "params": {
          "include_raw": false,
          "include_encoded": true
        }
      }
    ],
    "feature_selection": [
      {
        "name": "stability",
        "params": {
          "inner_selector": "boruta",
          "inner_params": {
            "n_iter": 5,
            "n_estimators": 30,
            "max_depth": 4,
            "min_z_score": 0.5
          },
          "n_bootstrap": 3,
          "threshold": 0.6,
          "bootstrap_ratio": 0.8
        }
      },
      {
        "name": "correlation_filter",
        "params": {
          "max_correlation": 0.7,
          "max_features": 15
        }
      }
    ]
  },
  "exit_strategy": "atr_based",
  "exit_params": "atr_standard_at_v1",
  "model": "xgboost_screen_v1",
  "validation": "walk_forward_screening_v1",
  "filters": "screening_v1",
  "resources": "exploration_heavy_v1",
  "grids": {
    "presets_dir": "../grids",
    "assignments": {
      "FOREX": {
        "preset": "screening_base_v1",
        "tp": [
          1.5,
          2.5,
          3.5
        ],
        "sl": [
          2.0,
          3.0,
          4.0
        ]
      },
      "INDEX": {
        "preset": "screening_base_v1",
        "tp": [
          2.0,
          3.0,
          4.0
        ],
        "sl": [
          3.0,
          4.0,
          5.0
        ]
      },
      "COMMODITY": {
        "preset": "screening_base_v1",
        "tp": [
          2.0,
          3.0,
          4.0
        ],
        "sl": [
          3.0,
          4.0,
          5.0
        ]
      },
      "CRYPTO": {
        "preset": "screening_base_v1",
        "tp": [
          2.0,
          3.0,
          5.0
        ],
        "sl": [
          3.0,
          5.0,
          7.0
        ]
      }
    }
  }
}