{
  "name": "orb-dax-baseline",
  "description": "DAX ORB Baseline: Signal-only, Range-Grid 30min/1h/2h, enge Breakout-Distanz. Isoliert den reinen ORB-Edge ohne Filter.",
  "tags": [
    "orb",
    "baseline",
    "index",
    "dax"
  ],
  "datasource": "dukascopy",
  "timeframe": "MINUTE_15",
  "assets": {
    "filter": [
      "DAX"
    ]
  },
  "pipeline": {
    "data_loading": [],
    "preprocessing": [],
    "indicators": [
      {
        "name": "opening_range",
        "params": {
          "range_bars": [
            2
          ],
          "atr_period": 14,
          "sessions": [
            8
          ],
          "enable_retracement": false,
          "carry_forward_days": [
            0
          ],
          "pre_range_bars": [
            0
          ],
          "candle_span": "body",
          "breakout_threshold": 0,
          "breakout_threshold_abs": 5,
          "retracement_levels": [],
          "min_retracement": 0,
          "min_range_height": 10,
          "min_range_height_atr": 0
        }
      }
    ],
    "feature_selection": []
  },
  "model": {
    "type": "signal",
    "architecture": "long_short_separate",
    "trade_directions": [
      "long",
      "short"
    ],
    "hyperparameters": {}
  },
  "validation": {
    "method": "walk_forward",
    "folds": 8
  },
  "filters": {},
  "resources": {},
  "risk_management": "vol_targeted_kelly",
  "risk_params": {
    "kelly_fraction": 0.25,
    "max_risk": 0.05,
    "target_max_dd": 0.3,
    "circuit_breaker_loss_range": [
      3,
      8
    ],
    "circuit_breaker_pause_range": [
      5,
      30
    ],
    "target_vol": 15,
    "min_scale": 0.25,
    "max_scale": 2
  },
  "exit_strategies": [
    {
      "name": "orb_based",
      "params": {
        "tp_mode": "range",
        "tp_mult": 3,
        "sl_mult": 1,
        "atr_period": 14,
        "min_tp_pips": 8,
        "min_sl_pips": 5,
        "timeout_bars": null,
        "sl_level": "none",
        "entry_delay": 0,
        "max_trades_per_signal": 1
      },
      "ct": [
        0.5
      ],
      "min_rrr": 2
    }
  ],
  "optimization": {
    "indicator_grid": {
      "opening_range": {
        "range_bars": [
          [
            2
          ],
          [
            4
          ],
          [
            8
          ]
        ],
        "pre_range_bars": [
          [
            0
          ],
          [
            4
          ]
        ]
      }
    }
  },
  "signal_rules": {
    "long": {
      "operator": "AND",
      "conditions": [
        {
          "type": "signal_active",
          "column": "breakout_up"
        },
        {
          "type": "value_check",
          "column": "breakout_dist",
          "op": "<=",
          "value": 0.05
        }
      ]
    },
    "short": {
      "operator": "AND",
      "conditions": [
        {
          "type": "signal_active",
          "column": "breakout_down"
        },
        {
          "type": "value_check",
          "column": "breakout_dist",
          "op": "<=",
          "value": 0.05
        }
      ]
    }
  }
}