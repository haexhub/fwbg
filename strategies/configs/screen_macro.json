{
  "name": "Screen: Macro",
  "description": "Konzept-Screening: Makro-Kontext (Risikosentiment, Yield Curve, Cross-Asset) als prim\u00e4re Signalquelle auf HOUR-Daten. Kein technisches Signal.",
  "tags": [
    "screening",
    "step1",
    "macro",
    "cross_asset"
  ],
  "hypothesis": "Makro-Faktoren (VIX-Regime, Yield Curve, Cross-Asset Flows) treiben systematische Bewegungen in FX, Indices und Rohstoffen - unabh\u00e4ngig von technischen Signalen.",
  "expected_outcome": "VIX-Niveau, Yield Curve Ver\u00e4nderungen und Cross-Asset Momentum werden selektiert. Asymmetrie zwischen Risk-On und Risk-Off Phasen.",
  "pipeline": {
    "indicators": [
      {
        "name": "macro_surprise",
        "params": {
          "vol_lookback": 20,
          "surprise_threshold": 2.0,
          "gap_ma_period": 10
        }
      },
      {
        "name": "trend",
        "params": {
          "adx_periods": [
            14
          ],
          "ema_periods": [
            50,
            200
          ],
          "sma_periods": [],
          "cci_periods": [],
          "aroon_period": 14,
          "er_periods": [
            10
          ],
          "supertrend_period": 14,
          "supertrend_multiplier": 3.0
        }
      },
      {
        "name": "time_season",
        "params": {
          "include_raw": false,
          "include_encoded": true
        }
      }
    ],
    "feature_selection": [
      {
        "name": "stability",
        "params": {
          "inner_selector": "boruta",
          "inner_params": {
            "n_iter": 5,
            "n_estimators": 30,
            "max_depth": 4,
            "min_z_score": 0.5
          },
          "n_bootstrap": 3,
          "threshold": 0.6,
          "bootstrap_ratio": 0.8
        }
      },
      {
        "name": "correlation_filter",
        "params": {
          "max_correlation": 0.7,
          "max_features": 20
        }
      }
    ],
    "data_loading": [
      {
        "name": "macro_data"
      }
    ]
  },
  "exit_strategy": "atr_based",
  "exit_params": "atr_standard_at_v1",
  "model": "xgboost_screen_v1",
  "validation": "walk_forward_screening_v1",
  "filters": "screening_v1",
  "resources": "exploration_heavy_v1",
  "grids": {
    "presets_dir": "../grids",
    "assignments": {
      "FOREX": {
        "preset": "screening_base_v1",
        "tp": [
          1.5,
          2.5,
          3.5
        ],
        "sl": [
          2.0,
          3.0,
          4.0
        ]
      },
      "INDEX": {
        "preset": "screening_base_v1",
        "tp": [
          2.0,
          3.0,
          4.0
        ],
        "sl": [
          3.0,
          4.0,
          5.0
        ]
      },
      "COMMODITY": {
        "preset": "screening_base_v1",
        "tp": [
          2.0,
          3.0,
          4.0
        ],
        "sl": [
          3.0,
          4.0,
          5.0
        ]
      },
      "CRYPTO": {
        "preset": "screening_base_v1",
        "tp": [
          2.0,
          3.0,
          5.0
        ],
        "sl": [
          3.0,
          5.0,
          7.0
        ]
      }
    }
  },
  "datasource": "forexsb"
}