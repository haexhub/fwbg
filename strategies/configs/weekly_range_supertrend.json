{
  "datasource": "dukascopy",
  "assets": {
    "filter": [
      "ASX200"
    ]
  },
  "pipeline": {
    "data_loading": [],
    "preprocessing": [],
    "indicators": [
      {
        "name": "weekly_opening_range",
        "params": {
          "range_bars": [
            5
          ],
          "atr_period": 14,
          "stat_window": 12,
          "enable_stats": true
        }
      },
      {
        "name": "trend",
        "params": {
          "adx_periods": [],
          "ema_periods": [],
          "sma_periods": [],
          "supertrend_period": 14,
          "supertrend_multiplier": 3,
          "macd_only": false
        }
      }
    ],
    "feature_selection": []
  },
  "exit_strategies": [
    {
      "name": "orb_based",
      "params": {
        "tp_mode": "atr",
        "tp_mult": 2,
        "sl_mult": 1,
        "atr_period": 14,
        "min_tp_pips": 8,
        "min_sl_pips": 5,
        "timeout_bars": null,
        "sl_level": "none",
        "entry_delay": 1,
        "max_trades_per_signal": 1
      },
      "ct": [
        0.5
      ],
      "min_rrr": 0
    }
  ],
  "model": {
    "type": "signal",
    "architecture": "long_short_separate",
    "trade_directions": [
      "long",
      "short"
    ],
    "hyperparameters": {}
  },
  "optimization": {},
  "validation": {
    "method": "walk_forward",
    "folds": 8
  },
  "filters": {},
  "resources": {},
  "name": "weekly_range_supertrend",
  "signal_rules": {
    "long": {
      "operator": "AND",
      "conditions": [
        {
          "type": "signal_active",
          "column": "wor_rb5_breakout_up"
        },
        {
          "type": "value_check",
          "column": "trend_supertrend",
          "op": "==",
          "value": 1.0
        }
      ]
    },
    "short": {
      "operator": "AND",
      "conditions": [
        {
          "type": "signal_active",
          "column": "wor_rb5_breakout_down"
        },
        {
          "type": "value_check",
          "column": "trend_supertrend",
          "op": "==",
          "value": -1.0
        }
      ]
    }
  }
}