{
  "name": "Exploration",
  "description": "Maximale Feature-Exploration mit allen verfügbaren Indicator-Plugins - ML lernt optimale Marktbedingungen",
  "tags": [
    "exploration",
    "parameter_search",
    "full_features",
    "ml_driven",
    "atr_based"
  ],
  "hypothesis": "ML soll selbst lernen, welche Features und Marktbedingungen relevant sind - keine harten Filter, maximale Feature-Vielfalt",
  "expected_outcome": "Identifikation der wichtigsten Features und profitablen Parameter-Bereiche durch Boruta Feature-Selektion",
  "pipeline": "exploration_full_v1",
  "exit_strategy": "atr_based",
  "exit_params": {
    "atr_period": [
      14
    ],
    "min_tp_pips": [
      10
    ],
    "min_sl_pips": [
      15
    ],
    "tp_mult": [
      1.5,
      2,
      2.5,
      3,
      3.5,
      4,
      4.5,
      5,
      6
    ],
    "sl_mult": [
      3,
      4,
      5,
      6,
      7
    ],
    "timeout_bars": [
      null,
      24,
      48
    ]
  },
  "model": "xgboost_depth4_v1",
  "validation": "walk_forward_exploration_v1",
  "filters": "permissive_v1",
  "resources": "exploration_heavy_v1",
  "datasource": "forexsb",
  "optimization": {
    "ct": [
      0.5,
      0.55,
      0.6,
      0.65
    ],
    "regime_filter_grid": {
      "condition_grids": [
        {
          "column": "trend_adx_14",
          "operator": ">=",
          "values": [
            null,
            25
          ],
          "directions": 6,
          "else_directions": 0
        },
        {
          "column": "macro_vix",
          "operator": "<=",
          "values": [
            null,
            30
          ],
          "directions": 6,
          "else_directions": 0
        },
        {
          "column": "regime_hurst_100",
          "operator": ">=",
          "values": [
            null,
            0.45
          ],
          "directions": 6,
          "else_directions": 0
        },
        {
          "column": "regime_cluster_label",
          "operator": ">=",
          "values": [
            null,
            1,
            2
          ],
          "directions": 6,
          "else_directions": 0
        }
      ]
    }
  }
}
