{
  "name": "Screen: Mean Reversion",
  "description": "Konzept-Screening: Mean-Reversion-Signale (RSI-Extreme, Bollinger Bands, Hurst) auf HOUR-Daten. Testet ob Rückkehr zum Mittelwert in ranging Märkten prädiktiv ist.",
  "tags": [
    "screening",
    "step1",
    "mean_reversion",
    "technical"
  ],
  "hypothesis": "Überverkaufte/überkaufte Situationen (RSI-Extreme, Preis außerhalb BB) haben in ranging Märkten (Hurst < 0.5) Edge für Rückkehr zum Mittelwert.",
  "expected_outcome": "RSI-Extreme und BB-Abweichung werden selektiert. Hurst-Exponent als Regime-Kontext wichtig.",
  "pipeline": {
    "indicators": [
      {
        "name": "momentum",
        "params": {
          "rsi_periods": [
            7,
            14,
            21
          ],
          "stoch_periods": [
            14
          ],
          "williams_periods": [
            14
          ],
          "roc_periods": [
            5
          ]
        }
      },
      {
        "name": "volatility",
        "params": {
          "bb_period": 20,
          "atr_periods": [
            14
          ],
          "vol_est_windows": [
            20
          ]
        }
      },
      {
        "name": "regime",
        "params": {
          "hurst_windows": [
            100,
            200
          ],
          "step": 10,
          "entropy_windows": [
            50
          ],
          "vr_windows": [
            100
          ],
          "vr_lags": [
            5
          ]
        }
      },
      {
        "name": "time_season",
        "params": {
          "include_raw": false,
          "include_encoded": true
        }
      }
    ],
    "feature_selection": [
      {
        "name": "stability",
        "params": {
          "inner_selector": "boruta",
          "inner_params": {
            "n_iter": 5,
            "n_estimators": 30,
            "max_depth": 4,
            "min_z_score": 0.5
          },
          "n_bootstrap": 3,
          "threshold": 0.6,
          "bootstrap_ratio": 0.8
        }
      },
      {
        "name": "correlation_filter",
        "params": {
          "max_correlation": 0.7,
          "max_features": 15
        }
      }
    ]
  },
  "exit_strategy": "atr_based",
  "exit_params": {
    "atr_period": [
      14
    ],
    "min_tp_pips": [
      8
    ],
    "min_sl_pips": [
      12
    ],
    "adaptive_timeout": [
      false
    ],
    "breakeven_trigger": [
      0.5
    ],
    "trail_atr_mult": [
      0.5
    ],
    "tp_mult": [
      1.0,
      1.5,
      2.0,
      2.5,
      3.0,
      4.0
    ],
    "sl_mult": [
      1.5,
      2.0,
      3.0,
      4.0,
      5.0
    ],
    "timeout_bars": [
      48
    ]
  },
  "model": "xgboost_screen_v1",
  "validation": "walk_forward_screening_v1",
  "filters": "screening_v1",
  "resources": "exploration_heavy_v1",
  "datasource": "forexsb",
  "optimization": {
    "ct": [
      0.5,
      0.6
    ]
  }
}
