{
  "name": "Screen: Mean Reversion",
  "description": "Konzept-Screening: Mean-Reversion-Signale (RSI-Extreme, Bollinger Bands, Hurst) auf HOUR-Daten. Testet ob R\u00fcckkehr zum Mittelwert in ranging M\u00e4rkten pr\u00e4diktiv ist.",
  "tags": [
    "screening",
    "step1",
    "mean_reversion",
    "technical"
  ],
  "hypothesis": "\u00dcberverkaufte/\u00fcberkaufte Situationen (RSI-Extreme, Preis au\u00dferhalb BB) haben in ranging M\u00e4rkten (Hurst < 0.5) Edge f\u00fcr R\u00fcckkehr zum Mittelwert.",
  "expected_outcome": "RSI-Extreme und BB-Abweichung werden selektiert. Hurst-Exponent als Regime-Kontext wichtig.",
  "pipeline": {
    "indicators": [
      {
        "name": "momentum",
        "params": {
          "rsi_periods": [
            7,
            14,
            21
          ],
          "stoch_periods": [
            14
          ],
          "williams_periods": [
            14
          ],
          "roc_periods": [
            5
          ]
        }
      },
      {
        "name": "volatility",
        "params": {
          "bb_period": 20,
          "atr_periods": [
            14
          ],
          "vol_est_windows": [
            20
          ]
        }
      },
      {
        "name": "regime",
        "params": {
          "hurst_windows": [
            100,
            200
          ],
          "step": 10,
          "entropy_windows": [
            50
          ],
          "vr_windows": [
            100
          ],
          "vr_lags": [
            5
          ]
        }
      },
      {
        "name": "time_season",
        "params": {
          "include_raw": false,
          "include_encoded": true
        }
      }
    ],
    "feature_selection": [
      {
        "name": "stability",
        "params": {
          "inner_selector": "boruta",
          "inner_params": {
            "n_iter": 5,
            "n_estimators": 30,
            "max_depth": 4,
            "min_z_score": 0.5
          },
          "n_bootstrap": 3,
          "threshold": 0.6,
          "bootstrap_ratio": 0.8
        }
      },
      {
        "name": "correlation_filter",
        "params": {
          "max_correlation": 0.7,
          "max_features": 15
        }
      }
    ]
  },
  "exit_strategy": "atr_based",
  "exit_params": "atr_intraday_at_v1",
  "model": "xgboost_screen_v1",
  "validation": "walk_forward_screening_v1",
  "filters": "screening_v1",
  "resources": "exploration_heavy_v1",
  "grids": {
    "presets_dir": "../grids",
    "assignments": {
      "FOREX": {
        "preset": "screening_mr_base_v1",
        "tp": [
          1.0,
          1.5,
          2.0
        ],
        "sl": [
          1.5,
          2.0,
          3.0
        ]
      },
      "INDEX": {
        "preset": "screening_mr_base_v1",
        "tp": [
          1.5,
          2.0,
          2.5
        ],
        "sl": [
          2.0,
          3.0,
          4.0
        ]
      },
      "COMMODITY": {
        "preset": "screening_mr_base_v1",
        "tp": [
          1.5,
          2.0,
          2.5
        ],
        "sl": [
          2.0,
          3.0,
          4.0
        ]
      },
      "CRYPTO": {
        "preset": "screening_mr_base_v1",
        "tp": [
          2.0,
          3.0,
          4.0
        ],
        "sl": [
          3.0,
          4.0,
          5.0
        ]
      }
    }
  }
}