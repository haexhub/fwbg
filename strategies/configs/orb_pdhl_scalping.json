{
  "name": "PDH/PDL Retest Scalping",
  "description": "Rule-based PDH/PDL strategy: breakout above Previous Day High or below Previous Day Low, entry on retracement to midpoint (PDH+PDL)/2. Grid search optimizes TP/SL only.",
  "tags": [
    "pdhl",
    "scalping",
    "intraday",
    "rule_based"
  ],
  "timeframe": "MINUTE_15",
  "hypothesis": "PDH/PDL breakouts with retracement to the range midpoint produce high-probability intraday setups. Direction is rule-based (breakout direction), optimizer tunes TP/SL via grid search.",
  "expected_outcome": "Trades only on retest signals after confirmed breakout above PDH or below PDL. Max 1 entry per direction per day.",
  "pipeline": "orb_scalping_v1",
  "exit_strategy": "atr_based",
  "exit_params": "atr_intraday_v1",
  "model": "signal_orb_v1",
  "validation": "walk_forward_intraday_v1",
  "filters": "orb_scalping_v1",
  "resources": "standard_v1",
  "grids": {
