{
  "name": "London/New York Overlap Strategy",
  "description": "Fokus auf die \u00dcberlappung London/NY (12:00-16:00 UTC) - h\u00f6chste Liquidit\u00e4t",
  "tags": [
    "london_session",
    "newyork_session",
    "overlap",
    "high_volatility",
    "atr_based"
  ],
  "hypothesis": "Die \u00dcberlappung bietet beste Liquidit\u00e4t und st\u00e4rkste Bewegungen",
  "expected_outcome": "Gr\u00f6\u00dfere Bewegungen, RRR 1.0-2.5",
  "indicators": [
    "trend",
    "momentum",
    "volatility",
    "time_season",
    "microstructure",
    "macro_surprise"
  ],
  "indicator_params": {
    "trend": {
      "adx_periods": [
        7,
        14
      ],
      "ema_periods": [
        21,
        50
      ]
    },
    "momentum": {
      "rsi_periods": [
        7,
        14
      ],
      "stoch_periods": [
        14
      ],
      "roc_periods": [
        5,
        10
      ]
    },
    "volatility": {
      "bb_periods": [
        20
      ],
      "atr_periods": [
        7,
        14
      ]
    },
    "time_season": {
      "include_raw": true,
      "include_encoded": true
    },
    "microstructure": {
      "atr_period": 7,
      "rolling_window": 5
    },
    "macro_surprise": {
      "vol_lookback": 10,
      "surprise_threshold": 1.5
    }
  },
  "exit_strategy": "atr_based",
  "exit_params": {
    "atr_period": 14,
    "min_tp_pips": 10,
    "min_sl_pips": 10
  },
  "feature_selector": "boruta",
  "feature_params": {
    "max_features": 30,
    "n_iter": 10,
    "n_estimators": 100
  },
  "model": {
    "type": "xgboost",
    "architecture": "long_short_separate",
    "trade_directions": [
      "long",
      "short"
    ],
    "hyperparameters": {
      "n_estimators": 150,
      "max_depth": 5,
      "learning_rate": 0.1,
      "subsample": 0.8,
      "colsample_bytree": 0.8
    }
  },
  "grids": {
    "FOREX": {
      "tp": [
        1.0,
        1.5,
        2.0,
        2.5,
        3.0
      ],
      "sl": [
        0.75,
