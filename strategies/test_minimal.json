{
  "name": "Test Minimal",
  "description": "Minimaler Test mit nur einem Indikator",
  "tags": ["test"],

  "indicators": ["trend"],

  "indicator_params": {
    "trend": {
      "adx_periods": [14],
      "ema_periods": [20, 50],
      "sma_periods": [20],
      "cci_periods": [14],
      "aroon_period": 25,
      "er_periods": [20]
    }
  },

  "exit_strategy": "fixed",
  "exit_params": {},

  "feature_selector": "boruta",
  "feature_params": {
    "max_features": 20,
    "n_iter": 3,
    "n_estimators": 20,
    "max_depth": 3,
    "min_z_score": 0.3
  },

  "preprocessing": [],

  "model": {
    "type": "xgboost",
    "architecture": "long_short_separate",
    "trade_directions": ["long", "short"],
    "hyperparameters": {
      "n_estimators": 50,
      "max_depth": 4,
      "learning_rate": 0.1,
      "random_state": 42
    }
  },

  "grids": {
    "FOREX": {
      "tp": [10, 20],
      "sl": [20, 30],
      "ct": [0.6]
    },
    "COMMODITY": {
      "tp": [10, 20],
      "sl": [30, 50],
      "ct": [0.6]
    }
  },

  "validation": {
    "method": "walk_forward",
    "folds": 3,
    "oos_size": 2000,
    "min_trades": 20,
    "n_inner_folds": 2
  },

  "filters": {
    "min_rrr": 0,
    "min_trades": 10,
    "min_annual_return": 0,
    "min_sharpe": 0,
    "max_drawdown": 1.0
  },

  "resources": {
    "ram_per_worker_gb": 1.0,
    "min_free_ram_percent": 0.10,
    "max_cpu_percent": 0.9,
    "xgboost_n_jobs": 0
  }
}
