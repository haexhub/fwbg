{
  "name": "Fractional Differentiation Exploration",
  "description": "Exploration mit stationaeren Preisdaten (Fractional Differentiation nach Lopez de Prado)",
  "tags": ["exploration", "fractional_differentiation", "stationary", "atr_based"],
  "hypothesis": "Stationaere Preisdaten durch Fractional Differentiation verbessern ML-Modell Performance bei Erhalt von Memory",
  "expected_outcome": "Bessere Generalisierung durch stationaere Features, weniger Overfitting",

  "indicators": [
    "trend",
    "momentum",
    "volatility",
    "regime",
    "structure",
    "dynamics"
  ],

  "indicator_params": {
    "trend": {
      "adx_periods": [14, 21],
      "ema_periods": [21, 50, 100]
    },
    "momentum": {
      "rsi_periods": [7, 14],
      "stoch_periods": [14]
    },
    "volatility": {
      "bb_periods": [20],
      "atr_periods": [7, 14]
    },
    "regime": {
      "hurst_windows": [100, 200]
    },
    "structure": {
      "fft_windows": [64, 128],
      "path_windows": [20, 50]
    },
    "dynamics": {
      "lookbacks": [4, 8, 24],
      "lag_periods": [8, 24]
    }
  },

  "exit_strategy": "atr_based",

  "exit_params": {
    "atr_period": 14,
    "min_tp_pips": 10,
    "min_sl_pips": 12
  },

  "feature_selector": "boruta",

  "feature_params": {
    "max_features": 30,
    "n_iter": 10,
    "n_estimators": 100
  },

  "preprocessing": ["fractional_diff"],

  "preprocessing_params": {
    "fractional_diff": {
      "auto_d": true,
      "default_d": 0.4,
      "columns": ["O", "H", "L", "C"]
    }
  },

  "model": {
    "type": "xgboost",
    "architecture": "long_short_separate",
    "trade_directions": ["long", "short"],
    "hyperparameters": {
      "n_estimators": 150,
      "max_depth": 5,
      "learning_rate": 0.1,
      "subsample": 0.8,
      "colsample_bytree": 0.8
    }
  },

  "grids": {
    "FOREX": {
      "tp": [0.5, 1.0, 1.5, 2.0, 2.5, 3.0, 4.0],
      "sl": [0.75, 1.0, 1.5, 2.0, 2.5, 3.0],
      "ct": [0.5, 0.52, 0.55, 0.58, 0.6, 0.65],
      "timeout_bars": [12, 24, 48, 96]
    },
    "INDEX": {
      "tp": [0.5, 1.0, 1.5, 2.0, 3.0, 4.0, 5.0],
      "sl": [1.0, 1.5, 2.0, 3.0, 4.0],
      "ct": [0.5, 0.52, 0.55, 0.6, 0.65],
      "timeout_bars": [12, 24, 48, 96]
    },
    "COMMODITY": {
      "tp": [0.5, 1.0, 1.5, 2.0, 3.0, 4.0],
      "sl": [1.0, 1.5, 2.0, 3.0],
      "ct": [0.5, 0.52, 0.55, 0.6, 0.65],
      "timeout_bars": [12, 24, 48, 96]
    },
    "CRYPTO": {
      "tp": [1.5, 2.0, 3.0, 5.0, 7.0],
      "sl": [1.5, 2.0, 3.0, 5.0, 7.0],
      "ct": [0.5, 0.52, 0.55, 0.6, 0.65],
      "timeout_bars": [12, 24, 48, 96]
    }
  },

  "validation": {
    "method": "walk_forward",
    "folds": 8,
    "oos_size": 4000,
    "min_trades": 80,
    "n_inner_folds": 5
  },

  "filters": {
    "min_rrr": 0.0,
    "min_trades": 30,
    "max_drawdown": 0.5
  },

  "resources": {
    "ram_per_feature_group_gb": 0.5,
    "cpu_per_feature_group": 0.5,
    "max_cpu_percent": 0.8
  }
}
