{
  "name": "ORB Exploration",
  "description": "Opening Range Breakout Feature-Test: ORB-Features + Kontext-Indikatoren auf M15-Daten.",
  "tags": ["orb", "exploration", "session_based", "intraday"],
  "timeframe": "MINUTE_15",
  "hypothesis": "Opening Range Breakout Features (rolling + session-spezifisch) liefern prädiktiven Edge, besonders für Indices und FX Majors bei Session-Opens. ML lernt welche Stunden und welche Breakout-Typen profitabel sind.",
  "expected_outcome": "Feature Selection wählt ORB-Features in stabilem Subset. Session-spezifische Features (s08, s13, s14) stärker als Rolling für Forex/Indices.",
  "pipeline": {
    "preprocessing": [
      {
        "name": "fractional_diff",
        "params": {
          "auto_d": false,
          "default_d": 0.4,
          "columns": ["O", "H", "L", "C"]
        }
      }
    ],
    "indicators": [
      {
        "name": "opening_range",
        "params": {
          "range_bars": 1,
          "atr_period": 14,
          "sessions": [0, 8, 13, 14],
          "stat_window": 20,
          "enable_rolling": true,
          "enable_session": true,
          "enable_stats": true
        }
      },
      {
        "name": "trend",
        "params": {
          "adx_periods": [7, 14, 21],
          "ema_periods": [8, 21, 50, 100, 200],
          "sma_periods": [20, 50, 200],
          "cci_periods": [14, 20],
          "aroon_period": 25,
          "er_periods": [10, 20, 50],
          "supertrend_period": 14,
          "supertrend_multiplier": 3.0
        }
      },
      {
        "name": "momentum",
        "params": {
          "rsi_periods": [7, 14, 21],
          "stoch_periods": [14, 21],
          "williams_periods": [14, 21],
          "roc_periods": [5, 10, 20]
        }
      },
      {
        "name": "volatility",
        "params": {
          "atr_periods": [7, 14, 21],
          "vol_est_windows": [20, 50]
        }
      },
      {
        "name": "price_action",
        "params": {
          "hh_ll_period": 5,
          "compute_volume": true
        }
      },
      {
        "name": "time_season",
        "params": {
          "include_raw": true,
          "include_encoded": true
        }
      },
      {
        "name": "regime",
        "params": {
          "hurst_windows": [100, 200, 500],
          "entropy_windows": [50, 100],
          "vr_windows": [100, 200],
          "vr_lags": [5, 10]
        }
      },
      {
        "name": "structure",
        "params": {
          "fft_windows": [64, 128, 256],
          "path_windows": [10, 20, 50, 100],
          "convexity_periods": [21, 50],
          "event_periods": [20, 50],
          "vwap_windows": [20, 50, 100]
        }
      },
      {
        "name": "distribution",
        "params": {
          "windows": [20, 50, 100],
          "z_score_lookback": 200,
          "compute_changes": true
        }
      },
      {
        "name": "dynamics",
        "params": {
          "lookbacks": [4, 8, 24],
          "lag_periods": [4, 8, 24, 48]
        }
      },
      {
        "name": "multi_timeframe",
        "params": {
          "h4_bars": 16,
          "d1_bars": 96,
          "ema_periods": [20, 50]
        }
      },
      {
        "name": "fair_value_gap",
        "params": {
          "atr_period": 14,
          "lookback": 100
        }
      },
      {
        "name": "market_regime",
        "params": {
          "window": 50
        }
      },
      {
        "name": "regime_cluster",
        "params": {
          "zscore_window": 200,
          "quantile_window": 500,
          "n_regimes": 3
        }
      },
      {
        "name": "macro_surprise",
        "params": {}
      }
    ],
    "feature_selection": [
      {
        "name": "stability",
        "params": {
          "inner_selector": "boruta",
          "inner_params": {
            "n_iter": 8,
            "n_estimators": 50,
            "max_depth": 5,
            "min_z_score": 0.5
          },
          "n_bootstrap": 7,
          "threshold": 0.6,
          "bootstrap_ratio": 0.8
        }
      },
      {
        "name": "correlation_filter",
        "params": {
          "max_correlation": 0.7,
          "max_features": 50
        }
      }
    ],
    "data_loading": [
      {
        "name": "macro_data",
        "source": "forexsb"
      },
      {
        "name": "cot_positioning",
        "source": "forexsb"
      }
    ]
  },
  "exit_strategy": "atr_based",
  "exit_params": {
    "atr_period": 14,
    "min_tp_pips": 10,
    "min_sl_pips": 15,
    "adaptive_timeout": false
  },
  "model": {
    "type": "xgboost",
    "architecture": "long_short_separate",
    "trade_directions": ["long", "short"],
    "hyperparameters": {
      "n_estimators": 100,
      "max_depth": 6,
      "learning_rate": 0.1,
      "subsample": 0.8,
      "colsample_bytree": 0.8,
      "random_state": 42
    }
  },
  "grids": {
    "FOREX": {
      "tp": [1.5, 2.0, 2.5, 3.0, 3.5],
      "sl": [3.0, 4.0, 5.0, 6.0],
      "ct": [0.5, 0.55, 0.6, 0.65],
      "timeout_bars": [null, 96, 192],
      "regime_filter_grid": {
        "condition_grids": [
          {"column": "trend_adx_14", "operator": ">=", "values": [null, 25], "directions": 6, "else_directions": 0},
          {"column": "regime_hurst_100", "operator": ">=", "values": [null, 0.45], "directions": 6, "else_directions": 0},
