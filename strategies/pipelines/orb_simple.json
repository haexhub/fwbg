{
  "indicators": [
    {
      "name": "opening_range",
      "params": {
        "range_bars": 1,
        "atr_period": 14,
        "sessions": [
          0,
          8,
          13,
          14
        ],
        "stat_window": 20,
        "enable_rolling": true,
        "enable_session": true,
        "enable_stats": true
      }
    },
    {
      "name": "trend",
      "params": {
        "adx_periods": [
          7,
          14,
          21
        ],
        "ema_periods": [
          8,
          21,
          50,
          100,
          200
        ],
        "sma_periods": [
          20,
          50,
          200
        ],
        "cci_periods": [
          14,
          20
        ],
        "aroon_period": 25,
        "er_periods": [
          10,
          20,
          50
        ],
        "supertrend_period": 14,
        "supertrend_multiplier": 3.0
      }
    },
    {
      "name": "momentum",
      "params": {
        "rsi_periods": [
          7,
          14,
          21
        ],
        "stoch_periods": [
          14,
          21
        ],
        "williams_periods": [
          14,
          21
        ],
        "roc_periods": [
          5,
          10,
          20
        ]
      }
    },
    {
      "name": "volatility",
      "params": {
        "atr_periods": [
          7,
          14,
          21
        ],
        "vol_est_windows": [
          20,
          50
        ]
      }
    },
    {
      "name": "time_season",
      "params": {
        "include_raw": true,
        "include_encoded": true
      }
    }
  ],
  "feature_selection": [
    {
      "name": "stability",
      "params": {
        "inner_selector": "boruta",
        "inner_params": {
          "n_iter": 8,
          "n_estimators": 50,
          "max_depth": 5,
          "min_z_score": 0.5
        },
        "n_bootstrap": 7,
        "threshold": 0.6,
        "bootstrap_ratio": 0.8
      }
    },
    {
      "name": "correlation_filter",
      "params": {
        "max_correlation": 0.7,
        "max_features": 50
      }
    }
  ],
  "data_loading": [
    {
      "name": "macro_data"
    }
  ]
}
