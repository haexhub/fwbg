{
  "indicators": [
    {
      "name": "weekly_opening_range",
      "params": {
        "range_bars": [2, 4],
        "atr_period": 14,
        "stat_window": 12,
        "enable_stats": true,
        "enable_retracement": true,
        "retest_atr_width": 0.3
      }
    },
    {
      "name": "opening_range",
      "params": {
        "range_bars": [1, 2],
        "atr_period": 14,
        "sessions": [8, 9, 14, 15],
        "stat_window": 20,
        "enable_rolling": true,
        "enable_session": true,
        "enable_stats": false,
        "enable_retracement": true,
        "retest_atr_width": 0.3
      }
    },
    {
      "name": "previous_day_levels",
      "params": {
        "atr_period": 14,
        "ma_period": 20
      }
    },
    {
      "name": "fair_value_gap",
      "params": {
        "atr_period": 14,
        "lookback": 100
      }
    },
    {
      "name": "microstructure",
      "params": {
        "atr_period": 14,
        "rolling_window": 5
      }
    },
    {
      "name": "volume_profile",
      "params": {
        "atr_period": 14,
        "n_levels": 50,
        "value_area_pct": 0.70
      }
    },
    {
      "name": "volatility",
      "params": {
        "atr_periods": [7, 14],
        "vol_est_windows": [20]
      }
    },
    {
      "name": "time_season",
      "params": {
        "include_raw": true,
        "include_encoded": true
      }
    }
  ],
  "feature_selection": [
    {
      "name": "stability",
      "params": {
        "inner_selector": "boruta",
        "inner_params": {
          "n_iter": 8,
          "n_estimators": 50,
          "max_depth": 5,
          "min_z_score": 0.5
        },
        "n_bootstrap": 7,
        "threshold": 0.6,
        "bootstrap_ratio": 0.8
      }
    },
    {
      "name": "correlation_filter",
      "params": {
        "max_correlation": 0.7,
        "max_features": 50
      }
    }
  ]
}
