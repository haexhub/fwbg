        0.6
      ],
      "timeout_bars": [
        null,
        24,
        48
      ]
    },
    "COMMODITY": {
      "tp": [
        1.0,
        1.5,
        2.0,
        2.5,
        3.0
      ],
      "sl": [
        1.0,
        1.5,
        2.0,
