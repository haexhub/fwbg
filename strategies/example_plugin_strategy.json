{
  "name": "Plugin Strategy Example",
  "description": "Beispiel-Strategie mit der neuen Plugin-basierten Struktur",
  "tags": [
    "plugin",
    "example",
    "atr_based"
  ],
  "hypothesis": "Demonstration der Plugin-Architektur mit ATR-basierter Exit-Strategie",
  "expected_outcome": "Zeigt wie Plugins konfiguriert werden",
  "indicators": [
    "trend",
    "momentum",
    "volatility"
  ],
  "indicator_params": {
    "trend": {
      "adx_periods": [
        14,
        21
      ],
      "ema_periods": [
        21,
        50,
        100
      ]
    },
    "momentum": {
      "rsi_periods": [
        14,
        21
      ]
    },
    "volatility": {
      "atr_periods": [
        14,
        21
      ]
    }
  },
  "exit_strategy": "atr_based",
  "exit_params": {
    "atr_period": 14,
    "min_tp_pips": 10,
    "min_sl_pips": 15
  },
  "feature_selector": "boruta",
  "feature_params": {
    "max_features": 30,
    "n_iter": 10,
    "min_z_score": 0.5
  },
  "preprocessing": [
    "fractional_diff"
  ],
  "preprocessing_params": {
    "fractional_diff": {
      "auto_d": true,
      "default_d": 0.4
    }
  },
  "model": {
    "type": "xgboost",
    "architecture": "long_short_separate",
    "trade_directions": [
      "long",
      "short"
    ],
    "hyperparameters": {
      "n_estimators": 100,
      "max_depth": 5,
      "random_state": 42
    }
  },
  "grids": {
    "FOREX": {
      "tp": [
        1.0,
        1.5,
        2.0,
        2.5,
        3.0
      ],
      "sl": [
        1.0,
        1.5,
        2.0,
        2.5
      ],
      "ct": [
        0.5,
        0.52,
        0.55,
        0.58,
        0.6
      ],
      "timeout_bars": [
        null,
        24,
        48,
        96
      ]
    },
    "INDEX": {
      "tp": [
        1.0,
        1.5,
        2.0,
