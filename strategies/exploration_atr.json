{
  "name": "Exploration ATR",
  "description": "Maximale Feature-Exploration mit ATR-basierter dynamischer Exit-Strategie - TP/SL passen sich der Volatilität an",
  "tags": [
    "exploration",
    "parameter_search",
    "full_features",
    "ml_driven",
    "atr_based",
    "dynamic_exits"
  ],
  "hypothesis": "ATR-basierte dynamische TP/SL bieten bessere Anpassung an Marktvolatilität als fixe Spread-Multiplikatoren. ML lernt optimale ATR-Multiplikatoren für verschiedene Marktregime.",
  "expected_outcome": "Höhere Risk-Adjusted Returns durch volatilitäts-angepasste Exits. Bessere Performance in verschiedenen Volatilitätsregimen.",

  "pipeline": {
    "preprocessing": [
      {"name": "fractional_diff", "params": {"auto_d": false, "default_d": 0.4, "columns": ["O", "H", "L", "C"]}}
    ],
    "indicators": [
      {"name": "trend", "params": {"adx_periods": [7, 14, 21], "ema_periods": [8, 21, 50, 100, 200], "sma_periods": [20, 50, 200], "cci_periods": [14, 20], "aroon_period": 25, "er_periods": [10, 20, 50], "supertrend_period": 14, "supertrend_multiplier": 3.0}},
      {"name": "momentum", "params": {"rsi_periods": [7, 14, 21], "stoch_periods": [14, 21], "williams_periods": [14, 21], "roc_periods": [5, 10, 20]}},
      {"name": "volatility", "params": {"bb_periods": [20], "atr_periods": [7, 14, 21], "vol_est_windows": [20, 50]}},
      {"name": "regime", "params": {"hurst_windows": [100, 200, 500], "step": 10, "entropy_windows": [50, 100], "vr_windows": [100, 200], "vr_lags": [5, 10]}},
      {"name": "structure", "params": {"fft_windows": [64, 128, 256], "path_windows": [10, 20, 50, 100], "convexity_periods": [21, 50], "event_periods": [20, 50], "vwap_windows": [20, 50, 100]}},
      {"name": "risk", "params": {"dd_windows": [50, 100, 200], "cvar_windows": [50, 100], "cvar_percentiles": [5, 1], "vov_windows": [20, 50, 100], "compute_correlations": true}},
      {"name": "price_action", "params": {"hh_ll_period": 5, "compute_volume": true}},
      {"name": "time_season", "params": {"include_raw": true, "include_encoded": true}},
      {"name": "distribution", "params": {"windows": [20, 50, 100], "z_score_lookback": 200, "compute_changes": true}},
      {"name": "dynamics", "params": {"lookbacks": [4, 8, 24], "lag_periods": [4, 8, 24, 48]}},
      {"name": "multi_timeframe", "params": {"h4_bars": 4, "d1_bars": 24, "ema_periods": [20, 50]}},
      {"name": "cross_features", "params": {"rsi_overbought": 70, "rsi_oversold": 30}},
      {"name": "ichimoku", "params": {"tenkan_period": 9, "kijun_period": 26, "senkou_b_period": 52}},
      {"name": "microstructure", "params": {"atr_period": 14, "rolling_window": 5}},
      {"name": "macro_surprise", "params": {"vol_lookback": 20, "surprise_threshold": 2.0, "gap_ma_period": 10}},
      {"name": "market_regime", "params": {"window": 50}},
      {"name": "regime_cluster", "params": {"zscore_window": 200, "quantile_window": 500, "n_regimes": 3}}
    ],
    "feature_selection": [
      {"name": "boruta", "params": {"max_features": 50, "n_iter": 8, "n_estimators": 50, "max_depth": 5, "min_z_score": 0.5}}
    ],
    "data_loading": [
      {"name": "macro_data", "source": "forexsb"},
      {"name": "cot_positioning", "source": "forexsb"}
    ]
  },

  "exit_strategy": "atr_based",

  "exit_params": {
    "atr_period": 14,
    "min_tp_pips": 10,
    "min_sl_pips": 15,
    "adaptive_timeout": false
  },

  "model": {
    "type": "xgboost",
    "architecture": "long_short_separate",
    "trade_directions": ["long", "short"],
    "hyperparameters": {
      "n_estimators": 100,
      "max_depth": 6,
      "learning_rate": 0.1,
      "subsample": 0.8,
      "colsample_bytree": 0.8,
      "random_state": 42
    }
  },

  "grids": {
    "FOREX": {
      "tp": [0.5, 1.0, 1.5, 2.0, 2.5],
      "sl": [0.5, 1.0, 1.5, 2.0, 2.5],
      "ct": [0.5, 0.55, 0.6, 0.65],
      "timeout_bars": [null, 24, 48],
      "regime_filter_grid": {
        "condition_grids": [
          {"column": "trend_adx_14", "operator": ">=", "values": [null, 25], "directions": 6, "else_directions": 0},
          {"column": "macro_vix", "operator": "<=", "values": [null, 30], "directions": 6, "else_directions": 0},
          {"column": "regime_hurst_100", "operator": ">=", "values": [null, 0.45], "directions": 6, "else_directions": 0},
          {"column": "regime_cluster_label", "operator": ">=", "values": [null, 1, 2], "directions": 6, "else_directions": 0}
        ]
      }
    },
    "INDEX": {
      "tp": [0.5, 1.0, 1.5, 2.0, 3.0],
      "sl": [0.5, 1.0, 1.5, 2.0, 3.0],
      "ct": [0.5, 0.55, 0.6, 0.65],
      "timeout_bars": [null, 24, 48],
      "regime_filter_grid": {
        "condition_grids": [
          {"column": "trend_adx_14", "operator": ">=", "values": [null, 25], "directions": 6, "else_directions": 0},
          {"column": "macro_vix", "operator": "<=", "values": [null, 30], "directions": 6, "else_directions": 0},
          {"column": "regime_hurst_100", "operator": ">=", "values": [null, 0.45], "directions": 6, "else_directions": 0},
          {"column": "regime_cluster_label", "operator": ">=", "values": [null, 1, 2], "directions": 6, "else_directions": 0}
        ]
      }
    },
    "COMMODITY": {
      "tp": [0.5, 1.0, 1.5, 2.0, 2.5],
      "sl": [0.5, 1.0, 1.5, 2.0, 2.5],
      "ct": [0.5, 0.55, 0.6, 0.65],
      "timeout_bars": [null, 24, 48],
      "regime_filter_grid": {
        "condition_grids": [
          {"column": "trend_adx_14", "operator": ">=", "values": [null, 25], "directions": 6, "else_directions": 0},
          {"column": "macro_vix", "operator": "<=", "values": [null, 30], "directions": 6, "else_directions": 0},
          {"column": "regime_hurst_100", "operator": ">=", "values": [null, 0.45], "directions": 6, "else_directions": 0},
          {"column": "regime_cluster_label", "operator": ">=", "values": [null, 1, 2], "directions": 6, "else_directions": 0}
        ]
      }
    },
    "CRYPTO": {
      "tp": [0.5, 1.0, 1.5, 2.0, 3.0],
      "sl": [0.5, 1.0, 1.5, 2.0, 3.0],
      "ct": [0.5, 0.55, 0.6, 0.65],
      "timeout_bars": [null, 24, 48],
      "regime_filter_grid": {
        "condition_grids": [
          {"column": "trend_adx_14", "operator": ">=", "values": [null, 25], "directions": 6, "else_directions": 0},
          {"column": "macro_vix", "operator": "<=", "values": [null, 30], "directions": 6, "else_directions": 0},
          {"column": "regime_hurst_100", "operator": ">=", "values": [null, 0.45], "directions": 6, "else_directions": 0},
          {"column": "regime_cluster_label", "operator": ">=", "values": [null, 1, 2], "directions": 6, "else_directions": 0}
        ]
      }
    }
  },

  "validation": {
    "method": "walk_forward",
    "folds": 8,
    "oos_size": 4000,
    "min_trades": 50,
    "n_inner_folds": 5,
    "embargo_bars": 100,
    "sample_weights": true
  },

  "filters": {
    "min_rrr": 0,
    "min_trades": 30,
    "min_annual_return": 0,
    "min_sharpe": 0,
    "max_drawdown": 1.0
  },

  "resources": {
    "ram_per_worker_gb": 4.0,
    "min_free_ram_percent": 0.15,
    "max_cpu_percent": 0.8,
    "max_concurrent_assets": 2,
    "xgboost_n_jobs": 0
  }
}
