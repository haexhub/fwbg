{
  "name": "All Trading Styles",
  "description": "Kombiniertes Grid das sowohl Scalping als auch Swing-Trading Strategien finden kann",
  "category": "trading_style",
  "tags": ["scalping", "swing", "comprehensive", "all_rrr"],
  "hypothesis": "Ein erweitertes Grid das alle TP/SL-Kombinationen von 15 bis 1000 testet, findet den optimalen Trading-Stil pro Asset automatisch",
  "expected_outcome": "Gemischte Ergebnisse - manche Assets profitieren von Scalping, andere von Swing-Trading",
  "baseline_run": null,
  "changes": [
    {
      "component": "grid",
      "before": "scalping only (TP: 15-80)",
      "after": "full range (TP: 15-1000)"
    },
    {
      "component": "max_trade_bars",
      "before": "48 (2 Tage)",
      "after": "480 (20 Tage)"
    },
    {
      "component": "kombinationen",
      "before": "~384 pro Asset",
      "after": "~1500+ pro Asset (deutlich längere Laufzeit!)"
    }
  ],
  "model": {
    "type": "xgboost",
    "architecture": "long_short_separate",
    "hyperparameters": {
      "n_estimators": 100,
      "max_depth": 5,
      "random_state": 42
    }
  },
  "features": {
    "technical_indicators": true,
    "macro_indicators": true,
    "time_features": true,
    "multi_timeframe": true,
    "feature_selection": "importance_based",
    "preferred_groups": ["trend_momentum", "macro_vol", "full_technical"]
  },
  "simulation": {
    "tp_sl_basis": "spread_multiple",
    "trailing_stop": true,
    "slippage_model": "fixed",
    "regime_filter": true,
    "max_trade_bars": 480
  },
  "validation": {
    "method": "walk_forward",
    "folds": 8,
    "oos_size": 4000,
    "min_trades": 30
  },
  "grids": {
    "FOREX": {
      "tp": [15, 20, 30, 50, 80, 100, 150, 200, 300, 500, 750, 1000],
      "sl": [15, 20, 30, 50, 80, 100, 150, 200, 300],
      "ct": [0.50, 0.55, 0.60, 0.65, 0.70, 0.75]
    },
    "INDEX": {
      "tp": [20, 50, 100, 200, 300, 500, 750, 1000],
      "sl": [20, 50, 100, 150, 200, 300],
      "ct": [0.50, 0.55, 0.60, 0.65, 0.70, 0.75]
    },
    "COMMODITY": {
      "tp": [20, 40, 80, 150, 300, 500, 750, 1000],
      "sl": [20, 40, 80, 150, 200, 300],
      "ct": [0.50, 0.55, 0.60, 0.65, 0.70, 0.75]
    },
    "CRYPTO": {
      "tp": [30, 80, 200, 400, 800, 1500, 2000],
      "sl": [30, 80, 200, 400, 500],
      "ct": [0.50, 0.55, 0.60, 0.65, 0.70]
    }
  },
  "filters": {
    "min_rrr": 0.0,
    "min_trades": 30
  },
  "resources": {
    "max_cpu_percent": 80,
    "min_free_ram_percent": 20,
    "ram_per_worker_gb": 4
  },
  "notes": "WARNUNG: Sehr viele Kombinationen! Laufzeit ca. 3-5x länger als normale Strategien. Das Grid testet TP von 15 bis 1000 Spreads, was bei EURUSD einer Range von 3 Pips bis 200 Pips entspricht."
}
