{
  "name": "Breakout Strategy",
  "description": "Handelt Ausbr\u00fcche aus Konsolidierungszonen, folgt dem Momentum",
  "tags": [
    "breakout",
    "momentum",
    "trend_start",
    "volatility_expansion",
    "atr_based"
  ],
  "hypothesis": "Ausbr\u00fcche aus engen Ranges f\u00fchren oft zu starken Bewegungen",
  "expected_outcome": "Moderate Win-Rate (40-55%) bei hoher RRR (1.5-3.0)",
  "indicators": [
    "volatility",
    "trend",
    "momentum",
    "price_action",
    "structure",
    "macro_surprise"
  ],
  "indicator_params": {
    "volatility": {
      "bb_periods": [
        20
      ],
      "atr_periods": [
        7,
        14,
        21
      ]
    },
    "trend": {
      "adx_periods": [
        14,
        21
      ],
      "ema_periods": [
        21,
        50
      ]
    },
    "momentum": {
      "rsi_periods": [
        14
      ],
      "roc_periods": [
        5,
        10,
        20
      ]
    },
    "price_action": {
      "hh_ll_period": 5,
      "compute_volume": true
    },
    "structure": {
      "path_windows": [
        10,
        20,
        50
      ],
      "event_periods": [
        20,
        50
      ]
    },
    "macro_surprise": {
      "vol_lookback": 20,
      "surprise_threshold": 1.5,
      "gap_ma_period": 10
    }
  },
  "exit_strategy": "atr_based",
  "exit_params": {
    "atr_period": 14,
    "min_tp_pips": 12,
    "min_sl_pips": 10
  },
  "feature_selector": "boruta",
  "feature_params": {
    "max_features": 30,
    "n_iter": 10,
    "n_estimators": 100
  },
  "model": {
    "type": "xgboost",
    "architecture": "long_short_separate",
    "trade_directions": [
      "long",
      "short"
    ],
    "hyperparameters": {
      "n_estimators": 150,
      "max_depth": 5,
      "learning_rate": 0.1,
      "subsample": 0.8,
      "colsample_bytree": 0.8
    }
  },
  "grids": {
    "FOREX": {
      "tp": [
        1.5,
        2.0,
        2.5,
        3.0,
        4.0
