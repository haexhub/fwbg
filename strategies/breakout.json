{
  "name": "Breakout Strategy",
  "description": "Handelt Ausbrueche aus Konsolidierungszonen, folgt dem Momentum",
  "category": "breakout",
  "tags": ["breakout", "momentum", "trend_start", "volatility_expansion"],
  "hypothesis": "Ausbrueche aus engen Ranges fuehren oft zu starken Bewegungen",
  "expected_outcome": "Moderate Win-Rate (40-55%) bei hoher RRR (1.5-3.0)",

  "grids": {
    "FOREX": {
      "tp": [40, 60, 80, 100, 150, 200],
      "sl": [20, 30, 40, 50, 60],
      "ct": [0.55, 0.60, 0.65, 0.70]
    },
    "INDEX": {
      "tp": [60, 100, 150, 200, 300],
      "sl": [30, 50, 70, 100],
      "ct": [0.55, 0.60, 0.65, 0.70]
    },
    "COMMODITY": {
      "tp": [50, 80, 120, 180, 250],
      "sl": [30, 50, 70, 100],
      "ct": [0.55, 0.60, 0.65, 0.70]
    },
    "CRYPTO": {
      "tp": [100, 200, 400, 600, 1000],
      "sl": [50, 100, 150, 200],
      "ct": [0.55, 0.60, 0.65]
    }
  },

  "simulation": {
    "max_trade_bars": 120,
    "tp_sl_basis": "spread_multiple",
    "trailing_stop": true,
    "slippage_model": "fixed",
    "regime_filter": true
  },

  "filters": {
    "min_rrr": 1.0,
    "min_trades": 40,
    "min_annual_return": 15.0
  },

  "features": {
    "preferred_groups": ["volatility", "trend_momentum", "price_action"]
  },

  "validation": {
    "method": "walk_forward",
    "folds": 8,
    "oos_size": 4000,
    "holdout_ratio": 0.20
  },

  "notes": "Breakouts erfordern schnelle Reaktion. Trailing Stop hilft bei False Breakouts Verluste zu begrenzen."
}
