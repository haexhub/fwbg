{
  "name": "S/R Trend Continuation",
  "description": "Isolierter Test der Support/Resistance Features: Long an Support im Uptrend, Short an Resistance im Downtrend, Range-Trading in Seitwärtsmärkten.",
  "tags": ["support_resistance", "trend_continuation", "price_action", "isolated_test"],
  "hypothesis": "S/R-Zonen mit Trend-Kontext liefern allein ausreichend Edge für profitable Entries — ohne klassische technische Indikatoren.",
  "expected_outcome": "Nachweis, dass die 31 S/R-Features prädiktiven Wert haben, bevor sie mit dem vollen Feature-Set kombiniert werden.",
  "pipeline": {
    "indicators": [
      {
        "name": "support_resistance",
        "params": {
          "swing_periods": [5, 10, 20],
          "lookback": 200,
          "cluster_threshold": 1.5,
          "atr_period": 14,
          "ma_periods": [20, 50, 200],
          "zone_proximity_atr_mult": 0.5,
          "d1_bars": 24
        }
      },
      {
        "name": "volatility",
        "params": {
          "atr_periods": [14],
          "bb_periods": [20],
          "vol_est_windows": [20]
        }
      },
      {
        "name": "time_season",
        "params": {
          "include_raw": true,
          "include_encoded": false
        }
      }
    ],
    "feature_selection": [
      {
        "name": "correlation_filter",
        "params": {
          "max_correlation": 0.7,
          "max_features": 20
        }
      }
    ]
  },
  "exit_strategy": "atr_based",
  "exit_params": {
    "atr_period": 14,
    "min_tp_pips": 8,
    "min_sl_pips": 12
  },
  "model": {
    "type": "xgboost",
    "architecture": "long_short_separate",
    "trade_directions": ["long", "short"],
    "hyperparameters": {
      "n_estimators": 100,
      "max_depth": 3,
      "learning_rate": 0.1,
      "subsample": 0.8,
      "colsample_bytree": 0.8,
      "random_state": 42
    }
  },
  "grids": {
    "FOREX": {
      "tp": [0.5, 0.8, 1.2, 1.5],
      "sl": [0.5, 0.8, 1.0, 1.5],
      "ct": [0.52, 0.55, 0.6],
      "timeout_bars": [null, 24, 48],
      "regime_filter_grid": {
        "condition_grids": [
          {
            "column": "sr_trend_class",
            "operator": ">=",
            "values": [null, 1, 2],
            "directions": 4,
            "else_directions": 0
          },
          {
            "column": "sr_trend_class",
            "operator": "<=",
            "values": [null, -1, -2],
            "directions": 2,
            "else_directions": 0
          }
        ]
      }
    },
    "INDEX": {
      "tp": [0.5, 0.8, 1.2, 1.5],
      "sl": [0.5, 0.8, 1.0, 1.5],
      "ct": [0.52, 0.55, 0.6],
      "timeout_bars": [null, 24, 48],
      "regime_filter_grid": {
        "condition_grids": [
          {
            "column": "sr_trend_class",
            "operator": ">=",
            "values": [null, 1, 2],
            "directions": 4,
            "else_directions": 0
          },
          {
            "column": "sr_trend_class",
            "operator": "<=",
            "values": [null, -1, -2],
            "directions": 2,
            "else_directions": 0
          }
        ]
      }
    },
    "COMMODITY": {
      "tp": [0.5, 0.8, 1.2, 2.0],
      "sl": [0.8, 1.0, 1.5, 2.0],
      "ct": [0.52, 0.55, 0.6],
      "timeout_bars": [null, 24, 48],
      "regime_filter_grid": {
        "condition_grids": [
          {
            "column": "sr_trend_class",
            "operator": ">=",
            "values": [null, 1, 2],
            "directions": 4,
            "else_directions": 0
          },
          {
            "column": "sr_trend_class",
            "operator": "<=",
            "values": [null, -1, -2],
            "directions": 2,
            "else_directions": 0
          }
        ]
      }
    },
    "CRYPTO": {
      "tp": [0.5, 1.0, 1.5, 2.0],
      "sl": [0.8, 1.0, 1.5, 2.5],
      "ct": [0.52, 0.55, 0.6],
      "timeout_bars": [null, 24, 48],
      "regime_filter_grid": {
        "condition_grids": [
          {
            "column": "sr_trend_class",
            "operator": ">=",
            "values": [null, 1, 2],
            "directions": 4,
            "else_directions": 0
          },
          {
            "column": "sr_trend_class",
            "operator": "<=",
            "values": [null, -1, -2],
            "directions": 2,
            "else_directions": 0
          }
        ]
      }
    }
  },
  "validation": {
    "method": "walk_forward",
    "folds": 8,
    "oos_size": 4000,
    "min_trades": 50,
    "n_inner_folds": 3,
    "embargo_bars": 50,
    "sample_weights": true,
    "early_pruning": {
      "enabled": true,
      "keep_ratio": 0.5,
      "min_survivors": 10
    },
    "probability_calibration": true,
    "calibration_method": "isotonic"
  },
  "filters": {
    "min_rrr": 0.3,
    "min_trades": 50,
    "min_annual_return": 0,
    "min_sharpe": 0,
    "max_drawdown": 1.0
  },
  "resources": {
    "ram_per_worker_gb": 4.0,
    "min_free_ram_percent": 0.15,
    "max_cpu_percent": 0.95,
    "max_concurrent_assets": 1,
    "xgboost_n_jobs": 0
  }
}
