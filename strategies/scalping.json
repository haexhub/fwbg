{
  "name": "Scalping",
  "description": "Kurzfristige Trades mit kleinen TP/SL-Zielen und hoher Win Rate",
  "tags": [
    "scalping",
    "high_frequency",
    "high_winrate",
    "short_hold",
    "atr_based"
  ],
  "hypothesis": "Kleine TP-Ziele (0.5-2.0 ATR) mit engem SL k\u00f6nnen hohe Win Rates erreichen",
  "expected_outcome": "Viele Trades, hohe Win Rate (>60%), niedrigeres RRR",
  "indicators": [
    "trend",
    "momentum",
    "volatility",
    "price_action",
    "microstructure",
    "time_season"
  ],
  "indicator_params": {
    "trend": {
      "adx_periods": [
        7,
        14
      ],
      "ema_periods": [
        8,
        21,
        50
      ]
    },
    "momentum": {
      "rsi_periods": [
        7,
        14
      ],
      "stoch_periods": [
        14
      ],
      "roc_periods": [
        5,
        10
      ]
    },
    "volatility": {
      "bb_periods": [
        20
      ],
      "atr_periods": [
        7,
        14
      ]
    },
    "price_action": {
      "hh_ll_period": 3,
      "compute_volume": true
    },
    "microstructure": {
      "atr_period": 7,
      "rolling_window": 3
    },
    "time_season": {
      "include_raw": true,
      "include_encoded": true
    }
  },
  "exit_strategy": "atr_based",
  "exit_params": {
    "atr_period": 7,
    "min_tp_pips": 8,
    "min_sl_pips": 10
  },
  "feature_selector": "boruta",
  "feature_params": {
    "max_features": 30,
    "n_iter": 10,
    "n_estimators": 100
  },
  "model": {
    "type": "xgboost",
    "architecture": "long_short_separate",
    "trade_directions": [
      "long",
      "short"
    ],
    "hyperparameters": {
      "n_estimators": 150,
      "max_depth": 5,
      "learning_rate": 0.1,
      "subsample": 0.8,
      "colsample_bytree": 0.8
    }
  },
  "grids": {
    "FOREX": {
      "tp": [
        0.5,
        0.75,
        1.0,
        1.25,
        1.5,
        2.0
      ],
      "sl": [
        0.5,
        0.75,
        1.0,
        1.25,
        1.5
      ],
      "ct": [
        0.5,
        0.52,
        0.55,
        0.58,
        0.6,
        0.65,
        0.7
      ],
      "timeout_bars": [
        6,
        12,
        24
      ]
    },
    "INDEX": {
      "tp": [
        0.5,
        0.75,
        1.0,
        1.5,
        2.0
      ],
      "sl": [
        0.5,
        0.75,
        1.0,
        1.5
      ],
      "ct": [
        0.5,
        0.52,
        0.55,
        0.6,
        0.65,
        0.7
      ],
      "timeout_bars": [
        6,
        12,
        24
      ]
    },
    "COMMODITY": {
      "tp": [
        0.5,
        0.75,
        1.0,
        1.5,
        2.0
      ],
      "sl": [
        0.5,
        0.75,
        1.0,
        1.5
      ],
      "ct": [
        0.5,
        0.52,
        0.55,
        0.58,
        0.62,
        0.65,
        0.7
      ],
      "timeout_bars": [
        6,
        12,
        24
      ]
    },
    "CRYPTO": {
      "tp": [
        0.75,
        1.0,
        1.5,
        2.0,
        2.5
      ],
      "sl": [
        0.75,
        1.0,
        1.5,
        2.0
      ],
      "ct": [
        0.5,
        0.52,
        0.55,
        0.6,
        0.65,
        0.7
      ],
      "timeout_bars": [
        6,
        12,
        24
      ]
    }
  },
  "validation": {
    "method": "walk_forward",
    "folds": 8,
    "oos_size": 4000,
    "min_trades": 100,
    "n_inner_folds": 5
  },
  "filters": {
    "min_rrr": 0.0,
    "min_trades": 50,
    "max_drawdown": 0.5
  },
  "resources": {
    "max_cpu_percent": 0.8
  }
}