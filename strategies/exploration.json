{
  "name": "Exploration",
  "description": "Breite Parameter-Suche mit allen Features - KI lernt selbst optimale Marktbedingungen",
  "tags": ["exploration", "parameter_search", "full_features", "ml_driven"],
  "hypothesis": "KI soll selbst lernen, welche Marktbedingungen (ADX, VIX, Hurst) wann relevant sind - keine harten Filter",
  "expected_outcome": "Identifikation von profitablen Parameter-Bereichen durch ML-gesteuerte Feature-Selektion",
  "model": {
    "architecture": "long_short_separate"
  },
  "preprocessing": {
    "fractional_differentiation": false,
    "frac_diff_auto_d": true,
    "frac_diff_default_d": 0.4,
    "log_returns": false,
    "normalize": false,
    "normalize_window": 100
  },
  "regime_filter": {
    "adx_enabled": false,
    "adx_min": 0,
    "vix_enabled": false,
    "vix_max": null,
    "hurst_enabled": false,
    "hurst_min": null,
    "hurst_max": null,
    "hurst_window": 100
  },
  "features": {
    "preferred_groups": [
      "trend",
      "momentum",
      "volatility",
      "price_action",
      "time",
      "macro",
      "dynamics",
      "mtf",
      "cross",
      "distribution",
      "fft",
      "regime",
      "trend_momentum",
      "macro_vol",
      "full_technical"
    ]
  },
  "grids": {
    "FOREX": {
      "tp": [10, 20, 30, 40, 50, 60, 80, 100],
      "sl": [20, 30, 40, 50, 60, 80, 100],
      "ct": [0.5, 0.52, 0.55, 0.58, 0.6, 0.65],
      "timeout_bars": [null, 12, 24, 48, 96]
    },
    "INDEX": {
      "tp": [10, 20, 30, 50, 70, 100, 150, 200],
      "sl": [30, 50, 70, 100, 150, 200],
      "ct": [0.5, 0.52, 0.55, 0.6, 0.65],
      "timeout_bars": [null, 12, 24, 48, 96]
    },
    "COMMODITY": {
      "tp": [10, 20, 30, 50, 70, 100, 150],
      "sl": [30, 50, 70, 100, 150],
      "ct": [0.5, 0.52, 0.55, 0.6, 0.65],
      "timeout_bars": [null, 12, 24, 48, 96]
    },
    "CRYPTO": {
      "tp": [50, 80, 120, 200, 300],
      "sl": [50, 80, 120, 200, 300],
      "ct": [0.5, 0.52, 0.55, 0.6, 0.65],
      "timeout_bars": [null, 12, 24, 48, 96]
    }
