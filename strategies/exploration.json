{
  "name": "Exploration",
  "description": "Maximale Feature-Exploration mit allen verfügbaren Indicator-Plugins - ML lernt optimale Marktbedingungen",
  "tags": [
    "exploration",
    "parameter_search",
    "full_features",
    "ml_driven",
    "atr_based"
  ],
  "hypothesis": "ML soll selbst lernen, welche Features und Marktbedingungen relevant sind - keine harten Filter, maximale Feature-Vielfalt",
  "expected_outcome": "Identifikation der wichtigsten Features und profitablen Parameter-Bereiche durch Boruta Feature-Selektion",

  "indicators": [
    "trend",
    "momentum",
    "volatility",
    "regime",
    "structure",
    "risk",
    "price_action",
    "time_season",
    "distribution",
    "dynamics",
    "multi_timeframe",
    "cross_features",
    "ichimoku",
    "microstructure",
    "macro_surprise"
  ],

  "indicator_params": {
    "trend": {
      "adx_periods": [7, 14, 21],
      "ema_periods": [8, 21, 50, 100, 200],
      "sma_periods": [20, 50, 200],
      "cci_periods": [14, 20],
      "aroon_period": 25,
      "er_periods": [10, 20, 50]
    },
    "momentum": {
      "rsi_periods": [7, 14, 21],
      "stoch_periods": [14, 21],
      "williams_periods": [14, 21],
      "roc_periods": [5, 10, 20]
    },
    "volatility": {
      "bb_periods": [20],
      "atr_periods": [7, 14, 21]
    },
    "regime": {
      "hurst_windows": [100, 200, 500],
      "step": 10
    },
    "structure": {
      "fft_windows": [64, 128, 256],
      "path_windows": [10, 20, 50, 100],
      "convexity_periods": [21, 50],
      "event_periods": [20, 50],
      "vwap_windows": [20, 50, 100]
    },
    "risk": {
      "dd_windows": [50, 100, 200],
      "cvar_windows": [50, 100],
      "cvar_percentiles": [5, 1],
      "vov_windows": [20, 50, 100],
      "compute_correlations": true
    },
    "price_action": {
      "hh_ll_period": 5,
      "compute_volume": true
    },
    "time_season": {
      "include_raw": true,
      "include_encoded": true
    },
    "distribution": {
      "windows": [20, 50, 100],
      "z_score_lookback": 200,
      "compute_changes": true
    },
    "dynamics": {
      "lookbacks": [4, 8, 24],
      "lag_periods": [4, 8, 24, 48]
    },
    "multi_timeframe": {
      "h4_bars": 4,
      "d1_bars": 24,
      "ema_periods": [20, 50]
    },
    "cross_features": {
      "rsi_overbought": 70,
      "rsi_oversold": 30
    },
    "ichimoku": {
      "tenkan_period": 9,
      "kijun_period": 26,
      "senkou_b_period": 52
    },
    "microstructure": {
      "atr_period": 14,
      "rolling_window": 5
    },
    "macro_surprise": {
      "vol_lookback": 20,
      "surprise_threshold": 2.0,
      "gap_ma_period": 10
    }
  },

  "exit_strategy": "fixed",

  "exit_params": {},

  "feature_selector": "boruta",

  "feature_params": {
    "max_features": 50,
    "n_iter": 8,
    "n_estimators": 50,
    "max_depth": 4,
    "min_z_score": 0.5
  },

  "preprocessing": ["fractional_diff"],

  "preprocessing_params": {
    "fractional_diff": {
      "auto_d": false,
      "default_d": 0.4,
      "columns": ["O", "H", "L", "C"]
    }
  },

  "model": {
    "type": "xgboost",
    "architecture": "long_short_separate",
    "trade_directions": ["long", "short"],
    "hyperparameters": {
      "n_estimators": 200,
      "max_depth": 6,
      "learning_rate": 0.1,
      "subsample": 0.8,
      "colsample_bytree": 0.8,
      "random_state": 42
    }
  },

  "grids": {
    "FOREX": {
      "tp": [10, 20, 30],
      "sl": [20, 30, 50],
      "ct": [0.6, 0.65],
      "timeout_bars": [null, 12, 24]
    },
    "INDEX": {
      "tp": [10, 20, 30, 50],
      "sl": [30, 50, 70],
      "ct": [0.6, 0.65],
      "timeout_bars": [null, 12, 24]
    },
    "COMMODITY": {
      "tp": [10, 20, 30],
      "sl": [30, 50, 70],
      "ct": [0.6, 0.65],
      "timeout_bars": [null, 12, 24]
    },
    "CRYPTO": {
      "tp": [20, 50, 80],
      "sl": [50, 80, 120],
      "ct": [0.6, 0.65],
      "timeout_bars": [null, 12, 24]
    }
  },

  "validation": {
    "method": "walk_forward",
    "folds": 8,
    "oos_size": 4000,
    "min_trades": 50,
    "n_inner_folds": 5
  },

  "filters": {
    "min_rrr": 0,
    "min_trades": 30,
    "min_annual_return": 0,
    "min_sharpe": 0,
    "max_drawdown": 1.0
  },

  "resources": {
    "ram_per_worker_gb": 2.0,
    "min_free_ram_percent": 0.10,
    "max_cpu_percent": 0.9,
    "xgboost_n_jobs": 0
  }
}
