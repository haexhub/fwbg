  "validation": {
    "method": "walk_forward",
    "folds": 8,
    "oos_size": 4000,
    "min_trades": 50,
    "n_inner_folds": 3,
    "embargo_bars": 100,
    "sample_weights": true,
    "early_pruning": {
      "enabled": true,
      "keep_ratio": 0.5,
      "min_survivors": 10
    },
    "probability_calibration": true,
    "calibration_method": "isotonic"
  },
  "filters": {
    "min_rrr": 0,
    "min_trades": 30,
    "min_annual_return": 0,
    "min_sharpe": 0,
    "max_drawdown": 1.0
  },
  "resources": {
    "ram_per_worker_gb": 8.0,
    "min_free_ram_percent": 0.15,
    "max_cpu_percent": 0.95,
    "max_concurrent_assets": 2,
    "xgboost_n_jobs": 0
  }
