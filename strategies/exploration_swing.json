{
  "name": "Exploration Swing",
  "description": "Swing-Trading-Exploration: Groessere TP/SL, laengere Haltezeiten, Fokus auf Trend, Regime und Multi-Timeframe",
  "tags": [
    "exploration",
    "swing",
    "medium_term",
    "trend_following"
  ],
  "hypothesis": "Swing-Trading profitiert von Trend-Alignment ueber mehrere Timeframes, Regime-Erkennung und strukturellen Features. Laengere Perioden und Geduld bei Entries.",
  "expected_outcome": "Identifikation profitabler Swing-Parameter mit gutem RRR und stabilen Trends ueber Folds",
  "pipeline": {
    "preprocessing": [
      {
        "name": "fractional_diff",
        "params": {
          "auto_d": false,
          "default_d": 0.4,
          "columns": [
            "O",
            "H",
            "L",
            "C"
          ]
        }
      }
    ],
    "indicators": [
      {
        "name": "trend",
        "params": {
          "adx_periods": [
            14,
            21,
            30
          ],
          "ema_periods": [
            21,
            50,
            100,
            200
          ],
          "sma_periods": [
            50,
            100,
            200
          ],
          "cci_periods": [
            20,
            30
          ],
          "aroon_period": 25,
          "er_periods": [
            20,
            50,
            100
          ],
          "supertrend_period": 20,
          "supertrend_multiplier": 3.0
        }
      },
      {
        "name": "momentum",
        "params": {
          "rsi_periods": [
            14,
            21
          ],
          "stoch_periods": [
            14,
            21
          ],
          "williams_periods": [
            14,
            21
          ],
          "roc_periods": [
            10,
            20,
            50
          ]
        }
      },
      {
        "name": "volatility",
        "params": {
          "bb_periods": [
            20
          ],
          "atr_periods": [
            14,
            21,
            30
          ],
          "vol_est_windows": [
            20,
            50,
            100
          ]
        }
      },
      {
        "name": "regime",
        "params": {
          "hurst_windows": [
            100,
            200,
            500
          ],
          "step": 10,
          "entropy_windows": [
            50,
            100,
            200
          ],
          "vr_windows": [
            100,
            200,
            500
          ],
          "vr_lags": [
            5,
            10,
            20
          ]
        }
      },
      {
        "name": "structure",
        "params": {
          "fft_windows": [
            128,
            256,
            512
          ],
          "path_windows": [
            20,
            50,
            100,
            200
          ],
          "convexity_periods": [
            50,
            100
          ],
          "event_periods": [
            50,
            100
          ],
          "vwap_windows": [
            50,
            100,
            200
          ]
        }
      },
      {
        "name": "risk",
        "params": {
          "dd_windows": [
            100,
            200,
            500
          ],
          "cvar_windows": [
            50,
            100
          ],
          "cvar_percentiles": [
            5,
            1
          ],
          "vov_windows": [
            50,
            100
          ],
          "compute_correlations": true
        }
      },
      {
        "name": "price_action",
        "params": {
          "hh_ll_period": 10,
          "compute_volume": true
        }
      },
      {
        "name": "time_season",
        "params": {
          "include_raw": true,
          "include_encoded": true
        }
      },
      {
        "name": "distribution",
        "params": {
          "windows": [
            50,
            100,
            200
          ],
          "z_score_lookback": 500,
          "compute_changes": true
        }
      },
      {
        "name": "dynamics",
        "params": {
          "lookbacks": [
            8,
            24,
            48
          ],
          "lag_periods": [
            8,
            24,
            48,
            96
          ]
        }
      },
      {
        "name": "multi_timeframe",
        "params": {
          "h4_bars": 4,
          "d1_bars": 24,
          "ema_periods": [
            20,
            50,
            100
          ]
        }
      },
      {
        "name": "cross_features",
        "params": {
          "rsi_overbought": 65,
          "rsi_oversold": 35
        }
      },
      {
        "name": "ichimoku",
        "params": {
          "tenkan_period": 9,
          "kijun_period": 26,
          "senkou_b_period": 52
        }
      },
      {
        "name": "microstructure",
        "params": {
          "atr_period": 14,
          "rolling_window": 10
        }
      },
      {
        "name": "macro_surprise",
        "params": {
          "vol_lookback": 50,
          "surprise_threshold": 1.5,
          "gap_ma_period": 20
        }
      },
      {
        "name": "market_regime",
        "params": {
          "window": 50
        }
      },
      {
        "name": "regime_cluster",
        "params": {
          "zscore_window": 200,
          "quantile_window": 500,
          "n_regimes": 3
        }
      }
    ],
    "feature_selection": [
      {
        "name": "stability",
        "params": {
          "inner_selector": "boruta",
          "inner_params": {"n_iter": 5, "n_estimators": 30, "max_depth": 4, "min_z_score": 0.5},
          "n_bootstrap": 7,
          "threshold": 0.6,
          "bootstrap_ratio": 0.8
        }
      },
      {
        "name": "correlation_filter",
        "params": {
          "max_correlation": 0.7,
          "max_features": 30
        }
      }
    ],
    "data_loading": [
      {
        "name": "macro_data",
        "source": "forexsb"
      },
      {
        "name": "cot_positioning",
        "source": "forexsb"
      }
    ]
  },
  "exit_strategy": "fixed",
  "exit_params": {},
  "model": {
    "type": "xgboost",
    "architecture": "long_short_separate",
    "trade_directions": [
      "long",
      "short"
    ],
    "hyperparameters": {
      "n_estimators": 100,
      "max_depth": 4,
      "learning_rate": 0.1,
      "subsample": 0.8,
      "colsample_bytree": 0.8,
      "random_state": 42
    }
  },
  "grids": {
    "FOREX": {
      "tp": [
        20,
        30,
        50,
        80
      ],
      "sl": [
        20,
        30,
        40,
        60
      ],
      "ct": [
        0.5,
        0.55,
        0.6
      ],
      "regime_filter_grid": {
        "condition_grids": [
          {
            "column": "trend_adx_14",
            "operator": ">=",
            "values": [
              null,
              25
            ],
            "directions": 6,
            "else_directions": 0
          },
          {
            "column": "macro_vix",
            "operator": "<=",
            "values": [
              null,
              30
            ],
            "directions": 6,
            "else_directions": 0
          },
          {
            "column": "regime_hurst_100",
            "operator": ">=",
            "values": [
              null,
              0.45
            ],
            "directions": 6,
            "else_directions": 0
          },
          {
            "column": "regime_cluster_label",
            "operator": ">=",
            "values": [
              null,
              1,
              2
            ],
            "directions": 6,
            "else_directions": 0
          }
        ]
      }
    },
