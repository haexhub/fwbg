{
  "name": "Swing Trading",
  "description": "L\u00e4ngerfristige Trades (Tage bis Wochen) mit gro\u00dfen TP/SL-Zielen",
  "tags": [
    "swing",
    "trend_following",
    "high_rrr",
    "long_hold",
    "atr_based"
  ],
  "hypothesis": "Swing-Trading mit gro\u00dfen TP-Zielen kann profitable Trend-Following-Setups identifizieren",
  "expected_outcome": "Weniger Trades, h\u00f6heres RRR (>1.5), l\u00e4ngere Haltezeit",
  "indicators": [
    "trend",
    "momentum",
    "regime",
    "multi_timeframe",
    "risk",
    "ichimoku",
    "dynamics"
