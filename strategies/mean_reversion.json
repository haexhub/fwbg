{
  "name": "Mean Reversion Strategy",
  "description": "Handelt gegen Extrembewegungen, erwartet Rueckkehr zum Mittelwert",
  "category": "mean_reversion",
  "tags": ["mean_reversion", "contrarian", "oversold_overbought"],
  "hypothesis": "Nach starken Bewegungen tendieren Maerkte zur Rueckkehr zum Mittelwert",
  "expected_outcome": "Hohe Win-Rate (65-80%) bei moderater RRR (0.5-1.5)",

  "grids": {
    "FOREX": {
      "tp": [20, 30, 40, 50, 60],
      "sl": [30, 40, 50, 60, 80],
      "ct": [0.60, 0.65, 0.70, 0.75, 0.80]
    },
    "INDEX": {
      "tp": [30, 50, 70, 100, 150],
      "sl": [50, 70, 100, 150, 200],
      "ct": [0.60, 0.65, 0.70, 0.75, 0.80]
    },
    "COMMODITY": {
      "tp": [30, 40, 60, 80, 100],
      "sl": [40, 60, 80, 100, 150],
      "ct": [0.60, 0.65, 0.70, 0.75, 0.80]
    },
    "CRYPTO": {
      "tp": [50, 80, 120, 200],
      "sl": [80, 120, 200, 300],
      "ct": [0.60, 0.65, 0.70, 0.75]
    }
  },

  "simulation": {
    "max_trade_bars": 72,
    "tp_sl_basis": "spread_multiple",
    "trailing_stop": false,
    "slippage_model": "fixed",
    "regime_filter": true
  },

  "filters": {
    "min_rrr": 0.0,
    "min_trades": 50,
    "min_annual_return": 12.0
  },

  "features": {
    "preferred_groups": ["momentum", "volatility", "cross"]
  },

  "validation": {
    "method": "walk_forward",
    "folds": 8,
    "oos_size": 4000,
    "holdout_ratio": 0.20
  },

  "notes": "Mean Reversion funktioniert am besten in Range-Maerkten. Hohe CT wichtig um nur bei starken Signalen zu handeln."
}
