{
  "name": "Mean Reversion Strategy",
  "description": "Contrarian-Ansatz - handelt gegen Extrembewegungen, erwartet Rückkehr zum Mittelwert",
  "tags": ["mean_reversion", "contrarian", "oversold_overbought", "atr_based"],
  "hypothesis": "Nach starken Bewegungen tendieren Märkte zur Rückkehr zum Mittelwert",
  "expected_outcome": "Hohe Win-Rate (60-75%) bei moderater RRR (0.5-1.5)",

  "indicators": [
    "momentum",
    "volatility",
    "distribution",
    "cross_features",
    "regime",
    "risk"
  ],

  "indicator_params": {
    "momentum": {
      "rsi_periods": [7, 14, 21],
      "stoch_periods": [14, 21],
      "williams_periods": [14, 21]
    },
    "volatility": {
      "bb_periods": [20],
      "atr_periods": [14]
    },
    "distribution": {
      "windows": [20, 50],
      "z_score_lookback": 100,
      "compute_changes": true
    },
    "cross_features": {
      "rsi_overbought": 70,
      "rsi_oversold": 30
    },
    "regime": {
      "hurst_windows": [100, 200]
    },
    "risk": {
      "dd_windows": [50, 100],
      "cvar_windows": [50]
    }
  },

  "exit_strategy": "atr_based",

  "exit_params": {
    "atr_period": 14,
    "min_tp_pips": 8,
    "min_sl_pips": 12
  },

  "feature_selector": "boruta",

  "feature_params": {
    "max_features": 30,
    "n_iter": 10,
    "n_estimators": 100
  },

  "model": {
    "type": "xgboost",
    "architecture": "long_short_separate",
    "trade_directions": ["long", "short"],
    "hyperparameters": {
      "n_estimators": 150,
      "max_depth": 5,
      "learning_rate": 0.1,
      "subsample": 0.8,
      "colsample_bytree": 0.8
    }
  },

  "grids": {
    "FOREX": {
      "tp": [0.5, 0.75, 1.0, 1.25, 1.5],
      "sl": [1.0, 1.25, 1.5, 2.0],
      "ct": [0.6, 0.65, 0.7, 0.75, 0.8],
      "timeout_bars": [12, 24, 48]
    },
    "INDEX": {
      "tp": [0.5, 0.75, 1.0, 1.5],
      "sl": [1.0, 1.5, 2.0],
      "ct": [0.6, 0.65, 0.7, 0.75, 0.8],
      "timeout_bars": [12, 24, 48]
    },
    "COMMODITY": {
      "tp": [0.5, 0.75, 1.0, 1.5],
      "sl": [1.0, 1.5, 2.0],
      "ct": [0.6, 0.65, 0.7, 0.75, 0.8],
      "timeout_bars": [12, 24, 48]
    },
    "CRYPTO": {
      "tp": [0.75, 1.0, 1.5, 2.0],
      "sl": [1.5, 2.0, 2.5],
      "ct": [0.6, 0.65, 0.7, 0.75],
      "timeout_bars": [24, 48]
    }
  },

  "validation": {
    "method": "walk_forward",
    "folds": 8,
    "oos_size": 4000,
    "min_trades": 100,
    "n_inner_folds": 5
  },

  "filters": {
    "min_rrr": 0.0,
    "min_trades": 50,
    "max_drawdown": 0.4
  },

  "resources": {
    "ram_per_feature_group_gb": 0.5,
    "cpu_per_feature_group": 0.5,
    "max_cpu_percent": 0.8
  }
}
