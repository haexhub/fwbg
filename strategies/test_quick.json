{
  "name": "QuickTest",
  "description": "Schneller Test mit reduziertem Grid",
  "tags": ["test", "quick", "atr_based"],
  "hypothesis": "Schnelltest für Entwicklung",
  "expected_outcome": "Schnelle Ausführung zur Validierung",

  "indicators": ["trend"],

  "indicator_params": {
    "trend": {
      "adx_periods": [14],
      "ema_periods": [21, 50]
    }
  },

  "exit_strategy": "atr_based",

  "exit_params": {
    "atr_period": 14,
    "min_tp_pips": 10,
    "min_sl_pips": 12
  },

  "feature_selector": "boruta",

  "feature_params": {
    "max_features": 15,
    "n_iter": 5,
    "n_estimators": 50
  },

  "model": {
    "type": "xgboost",
    "architecture": "long_short_separate",
    "trade_directions": ["long", "short"],
    "hyperparameters": {
      "n_estimators": 50,
      "max_depth": 4,
      "learning_rate": 0.1,
      "subsample": 0.8,
      "colsample_bytree": 0.8
    }
  },

  "grids": {
    "FOREX": {
      "tp": [1.0, 2.0],
      "sl": [1.0, 2.0],
      "ct": [0.5, 0.55],
      "timeout_bars": [24]
    }
  },

  "validation": {
    "method": "walk_forward",
    "folds": 3,
    "oos_size": 2000,
    "min_trades": 30,
    "n_inner_folds": 3
  },

  "filters": {
    "min_rrr": 0.0,
    "min_trades": 30,
    "max_drawdown": 0.5
  },

  "resources": {
    "ram_per_feature_group_gb": 0.5,
    "cpu_per_feature_group": 0.5,
    "max_cpu_percent": 0.8
  }
}
