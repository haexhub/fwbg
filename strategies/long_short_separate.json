{
  "name": "Separate Long/Short Modelle",
  "description": "Trainiert separate XGBoost-Modelle für Long und Short Trades",
  "tags": ["long_short", "xgboost", "macro", "atr_based"],
  "hypothesis": "Separate Modelle für Long und Short sollten besser performen, da unterschiedliche Marktbedingungen für profitable Long vs Short Trades relevant sind",
  "expected_outcome": "Höhere Sharpe Ratio und mehr profitable Assets durch spezialisierte Modelle",

  "indicators": [
    "trend",
    "momentum",
    "volatility",
    "regime",
    "risk",
    "dynamics"
  ],

  "indicator_params": {
    "trend": {
      "adx_periods": [14, 21],
      "ema_periods": [21, 50, 100]
    },
    "momentum": {
      "rsi_periods": [7, 14],
      "stoch_periods": [14]
    },
    "volatility": {
      "bb_periods": [20],
      "atr_periods": [7, 14]
    },
    "regime": {
      "hurst_windows": [100, 200]
    },
    "risk": {
      "dd_windows": [50, 100],
      "cvar_windows": [50],
      "vov_windows": [20, 50],
      "compute_correlations": true
    },
    "dynamics": {
      "lookbacks": [4, 8, 24],
      "lag_periods": [8, 24]
    }
  },

  "exit_strategy": "atr_based",

  "exit_params": {
    "atr_period": 14,
    "min_tp_pips": 10,
    "min_sl_pips": 12
  },

  "feature_selector": "boruta",

  "feature_params": {
    "max_features": 30,
    "n_iter": 10,
    "n_estimators": 100
  },

  "model": {
    "type": "xgboost",
    "architecture": "long_short_separate",
    "trade_directions": ["long", "short"],
    "hyperparameters": {
      "n_estimators": 150,
      "max_depth": 5,
      "learning_rate": 0.1,
      "subsample": 0.8,
      "colsample_bytree": 0.8
    }
  },

  "grids": {
    "FOREX": {
      "tp": [1.0, 1.5, 2.0, 2.5, 3.0],
      "sl": [0.75, 1.0, 1.5, 2.0],
      "ct": [0.5, 0.52, 0.55, 0.6, 0.65],
      "timeout_bars": [12, 24, 48]
    },
    "INDEX": {
      "tp": [1.0, 1.5, 2.0, 2.5, 3.0],
      "sl": [0.75, 1.0, 1.5, 2.0],
      "ct": [0.5, 0.52, 0.55, 0.6, 0.65],
      "timeout_bars": [12, 24, 48]
    },
    "COMMODITY": {
      "tp": [1.0, 1.5, 2.0, 2.5, 3.0],
      "sl": [0.75, 1.0, 1.5, 2.0],
      "ct": [0.5, 0.52, 0.55, 0.6, 0.65],
      "timeout_bars": [12, 24, 48]
    },
    "CRYPTO": {
      "tp": [1.5, 2.0, 2.5, 3.0, 4.0],
      "sl": [1.0, 1.5, 2.0, 3.0],
      "ct": [0.5, 0.52, 0.55, 0.6],
      "timeout_bars": [24, 48, 96]
    }
  },

  "validation": {
    "method": "walk_forward",
    "folds": 8,
    "oos_size": 4000,
    "min_trades": 80,
    "n_inner_folds": 5
  },

  "filters": {
    "min_rrr": 0.0,
    "min_trades": 50,
    "max_drawdown": 0.4
  },

  "resources": {
    "ram_per_feature_group_gb": 0.5,
    "cpu_per_feature_group": 0.5,
    "max_cpu_percent": 0.8
  }
}
