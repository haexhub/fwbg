{
  "preprocessing": [
    {
      "name": "fractional_diff",
      "params": {
        "auto_d": false,
        "default_d": 0.4,
        "columns": ["O", "H", "L", "C"]
      }
    }
  ],
  "indicators": [
    {
      "name": "trend",
      "params": {
        "adx_periods": [7, 14, 21],
        "ema_periods": [8, 21, 50, 100, 200],
        "supertrend_period": 14,
        "supertrend_multiplier": 3.0
      }
    },
    {
      "name": "momentum",
      "params": {
        "rsi_periods": [7, 14, 21]
      }
    },
    {
      "name": "volatility",
      "params": {
        "atr_periods": [7, 14, 21],
        "vol_est_windows": [20, 50]
      }
    },
    {
      "name": "regime",
      "params": {
        "hurst_windows": [100, 200, 500],
        "entropy_windows": [50, 100],
        "vr_windows": [100, 200],
        "vr_lags": [5, 10]
      }
    },
    {
      "name": "structure",
      "params": {}
    },
    {
      "name": "risk",
      "params": {
        "dd_windows": [50, 100, 200]
      }
    },
    {
      "name": "price_action",
      "params": {}
    },
    {
      "name": "time_season",
      "params": {}
    },
    {
      "name": "distribution",
      "params": {
        "windows": [20, 50, 100]
      }
    },
    {
      "name": "dynamics",
      "params": {}
    },
    {
      "name": "multi_timeframe",
      "params": {}
    },
    {
      "name": "cross_features",
      "params": {}
    },
    {
      "name": "ichimoku",
      "params": {}
    },
    {
      "name": "microstructure",
      "params": {}
    },
    {
      "name": "macro_surprise",
      "params": {}
    },
    {
      "name": "market_regime",
      "params": {
        "window": 50
      }
    },
    {
      "name": "regime_cluster",
      "params": {
        "zscore_window": 200,
        "quantile_window": 500,
        "n_regimes": 3
      }
    },
    {
      "name": "fair_value_gap",
      "params": {}
    },
    {
      "name": "support_resistance",
      "params": {}
    },
    {
      "name": "cusum_events",
      "params": {}
    },
    {
      "name": "calendar_events",
      "params": {}
    },
    {
      "name": "fractal_dimension",
      "params": {}
    },
    {
      "name": "wavelets",
      "params": {}
    },
    {
      "name": "autoencoder_features",
      "params": {}
    },
    {
      "name": "topological_features",
      "params": {}
    },
    {
      "name": "adversarial_validation",
      "params": {}
    }
  ],
  "feature_selection": [
    {
      "name": "stability",
      "params": {
        "inner_selector": "boruta",
        "inner_params": {
          "n_estimators": 50,
          "max_depth": 4,
          "min_z_score": 0.5
        },
        "n_bootstrap": 5,
        "threshold": 0.6,
        "bootstrap_ratio": 0.8
      }
    },
    {
      "name": "correlation_filter",
      "params": {
        "max_correlation": 0.7,
        "max_features": 50
      }
    }
  ],
  "data_loading": [
    {
      "name": "macro_data",
      "source": "forexsb"
    },
    {
      "name": "cot_positioning",
      "source": "forexsb"
    }
  ]
}
